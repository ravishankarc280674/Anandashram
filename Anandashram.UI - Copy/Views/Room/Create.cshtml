@model Anandashram.Models.Room
@{
    ViewData["Title"] = "Room - Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="section-card mt-4 mx-auto" style="max-width: 800px;">
    <div class="section-header d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-plus-circle me-2"></i>Room - Create</span>
        <a class="btn btn-sm btn-light fw-semibold"
           asp-action="Index" asp-route-pg="@TempData.Peek("CurrentPage")">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="p-4">
        <form asp-action="Create" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Hidden Fields -->
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />

            <!-- Room Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter room name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <input asp-for="Description" class="form-control" placeholder="Enter short description" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Building & Block -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="BuildingId" class="form-label fw-semibold"></label>
                    <select asp-for="BuildingId" class="form-select" asp-items="ViewBag.BuildingId"></select>
                    <span asp-validation-for="BuildingId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="BlockId" class="form-label fw-semibold"></label>
                    <select asp-for="BlockId" class="form-select" asp-items="ViewBag.BlockId"></select>
                    <span asp-validation-for="BlockId" class="text-danger"></span>
                </div>
            </div>

            <!-- Floor -->
            <div class="mb-3">
                <label asp-for="FloorId" class="form-label fw-semibold"></label>
                <select asp-for="FloorId" class="form-select" asp-items="ViewBag.FloorId"></select>
                <span asp-validation-for="FloorId" class="text-danger"></span>
            </div>

            <!-- Capacity -->
            <div class="mb-4">
                <label asp-for="Capacity" class="form-label fw-semibold"></label>
                <input asp-for="Capacity" type="number" min="0" class="form-control" placeholder="Enter room capacity" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <!-- Action Buttons -->
            <div class="text-center">
                <button type="submit" class="btn btn-success px-4 me-2">
                    <i class="fa-solid fa-save"></i> Create
                </button>
                <a class="btn btn-outline-secondary px-4"
                   asp-action="Index" asp-route-pg="@TempData.Peek("CurrentPage")">
                    <i class="fa-solid fa-arrow-rotate-left"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
