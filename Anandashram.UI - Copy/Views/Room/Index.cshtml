@model IEnumerable<Room>

@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = currentModel + " - Edit";
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = TempData["CurrentPage"] as int? ?? 1;
    PageModel pager = ViewBag.SearchPager ?? ViewBag.Pager;
}
<style>
    
    table.green-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-bottom: 0;
    }
    .green-table thead th {
        background-color: #0f5132 !important;
        color: white !important;
        font-weight: 400;
        text-align: center;
        vertical-align: middle;
        padding: 10px;
        font-size: 16px;
    }
        .green-table tbody td {
        vertical-align: middle;
        padding: 10px;
        font-size: 15px;
    }

    .green-table tbody tr:nth-child(even) {
        background-color: #e9f5ea;
    }
    .table-no-data {
        text-align: center;
        font-style: italic;
        color: #777;
        background-color: #fafafa;
    }
    .green-table tbody tr:hover {
        background-color: #d7f3d8;
    }

    table.table-hover tbody tr:hover {
        background-color: #e6f4ea; /* light green hover */
    }

    table td, table th {
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }
</style>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-success">
            <i class="fas fa-door-open me-2"></i>@currentModel - List
        </h3>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Create New
        </a>
    </div>

    <div class="mb-3">
        <partial name="_PagerSearchOnly" model="@pager" />
    </div>

    @if (pager.ViewType == "Tile")
    {
        <div class="row g-3">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card shadow-sm border-0">
                            <div class="card-header text-white fw-bold text-center" style="background-color: #198754;">
                                @item.Name
                            </div>
                            <div class="card-body border-top" style="border-color: #198754;">
                                <dl class="row mb-0">
                                    <dt class="col-6 text-muted">Building:</dt>
                                    <dd class="col-6 fw-semibold">@item.BuildingName</dd>
                                    <dt class="col-6 text-muted">Block:</dt>
                                    <dd class="col-6 fw-semibold">@item.BlockName</dd>
                                    <dt class="col-6 text-muted">Floor:</dt>
                                    <dd class="col-6 fw-semibold">@item.FloorName</dd>
                                    <dt class="col-6 text-muted">Capacity:</dt>
                                    <dd class="col-6 fw-semibold">@item.Capacity</dd>
                                </dl>
                            </div>
                            <div class="card-footer text-center bg-light">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success me-1">
                                    <i class="fa fa-edit" title="Edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark me-1">
                                    <i class="fa fa-eye" title="Details"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash" title="Delete"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p>No records found.</p>
                </div>
            }
        </div>
    }
    else if (pager.ViewType == "Grid")
    {
        <div class="table-responsive mt-3">
            <table class="table table-hover align-middle shadow-sm green-table">
                <thead class="table-success text-dark">
                    <tr>
                        <th>Building</th>
                        <th>Block</th>
                        <th>Floor</th>
                        <th>Room</th>
                        <th>Description</th>
                        <th>Capacity</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var distinctBuildings = Model.DistinctBy(p => p.BuildingId).Select(g => new { g.BuildingId, g.BuildingName }).ToList();

                        foreach (var distinctBuild in distinctBuildings)
                        {
                            var buildingRowsList = Model.Where(p => p.BuildingId == distinctBuild.BuildingId).ToList();
                            var buildingCount = buildingRowsList.Count();

                            @:<tr>
                            <td rowspan="@buildingCount" class="align-middle fw-semibold text-success">@distinctBuild.BuildingName</td>

                            var distinctBlocks = buildingRowsList.DistinctBy(p => p.BlockId).Select(g => new { g.BuildingId, g.BlockId, g.BlockName });
                            foreach (var distinctBlock in distinctBlocks)
                            {
                                var blockRowsList = Model.Where(p => p.BlockId == distinctBlock.BlockId && p.BuildingId == distinctBlock.BuildingId).ToList();
                                var blockCount = blockRowsList.Count();

                                <td rowspan="@blockCount" class="align-middle">@distinctBlock.BlockName</td>

                                var distinctFloors = blockRowsList.DistinctBy(p => p.FloorId).Select(g => new { g.BuildingId, g.BlockId, g.FloorId, g.FloorName });
                                foreach (var distinctFloor in distinctFloors)
                                {
                                    var floorRowsList = Model.Where(p =>
                                        p.BlockId == distinctBlock.BlockId &&
                                        p.BuildingId == distinctBlock.BuildingId &&
                                        p.FloorId == distinctFloor.FloorId).ToList();

                                    var floorCount = floorRowsList.Count();
                                    <td rowspan="@floorCount" class="align-middle">@distinctFloor.FloorName</td>

                                    for (int iLoop = 0; iLoop < floorRowsList.Count; iLoop++)
                                    {
                                        if (iLoop != 0)
                                            @Html.Raw("<tr>")

                                        <td>@floorRowsList[iLoop].Name</td>
                                        <td>@floorRowsList[iLoop].Description</td>
                                        <td>@floorRowsList[iLoop].Capacity</td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@floorRowsList[iLoop].Id" class="btn btn-sm btn-outline-success">
                                                    <i class="fa fa-edit" title="Edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@floorRowsList[iLoop].Id" class="btn btn-sm btn-outline-dark">
                                                    <i class="fa fa-eye" title="Details"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@floorRowsList[iLoop].Id" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-trash" title="Delete"></i>
                                                </a>
                                            </div>
                                        </td>
                                        @Html.Raw("</tr>")
                                    }
                                }
                            }
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted">No records found</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
