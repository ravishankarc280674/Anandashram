@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="IndexDiv">

    <div class="row">
        <div class="container CenteredContainer text-center">
            <form id="account" method="post" class="p-4 shadow-sm rounded bg-white border border-light">
                <h5 class="text-success fw-semibold col=6">Welcome</h5>
                <hr class="mb-4" />

                <div asp-validation-summary="All" class="text-danger mb-1"></div>

                <div class="form-group mb-3">
                    <input asp-for="Input.Email" class="form-control form-control rounded" placeholder="Email" />
                </div>

                <div class="form-group mb-3">
                    <input asp-for="Input.Password" class="form-control form-control rounded" placeholder="Password" />
                </div>

                <div class="form-group mb-1">
                    <div class="checkbox text-start">
                        <label asp-for="Input.RememberMe" class="text-secondary">
                            <input asp-for="Input.RememberMe" style="width:auto; margin-right:5px;" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <input type="submit" class="btn btn-success text-white w-100 fw-semibold" value="Log In" />
                </div>

                <div class="form-group">
                    <p class="mb-0">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="text-success text-decoration-none">
                            Forgot your password?
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
