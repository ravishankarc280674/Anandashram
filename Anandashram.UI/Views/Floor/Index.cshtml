@model IEnumerable<Floor>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = $"{currentModel} - List";
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = TempData["CurrentPage"] != null ? (int)TempData["CurrentPage"] : 1;
    TempData["CurrentPage"] = pg;
    PageModel pager = ViewBag.Pager;
    var SearchText = @ViewBag.SearchText;
    int pageNo = ViewBag.SearchPager?.CurrentPage ?? 0;
    pager = ViewBag.SearchPager ?? pager;
    ViewData["SortModel"] = sortModel;
    ViewBag.Pager = pager;
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0 text-success">
            <i class="fas fa-building"></i> @currentModel - List
        </h3>
        <a onclick="showInPopup('@Url.Action("AddOrEdit", "Floor", null, Context.Request.Scheme)',
                                '@currentModel - New')"
           class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Create New
        </a>
    </div>

    <partial name="_pager" model="@pager" />

    <div id="view-all">
        @await Html.PartialAsync("_ViewAll", Model)
    </div>

    <partial name="_BottomBar" model="@pager" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
