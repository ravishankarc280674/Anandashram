@model IEnumerable<Room>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];
        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;
    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}
 

<div class="reservation-container mt-3">
    <div class="d-flex align-items-center mb-3">
        <i class="fas fa-calendar-check text-success me-2 fa-lg"></i>
        <h3 class="fw-bold text-success mb-0">Reservation List</h3>
    </div>

    <div class="row mb-2">
        <div class="col-12">
            <partial name="_PagerSearchOnly" model="@pager" />
        </div>
    </div>

    <div class="table-responsive">
        <table id="tblRoomList" class="table green-table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Building</th>
                    <th>Block</th>
                    <th>Floor</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var distinctRooms = Model
                    .DistinctBy(p => p.Id)
                    .Select(g => new
                    {
                        g.Id,
                        g.Name,
                        g.BuildingName,
                        g.BlockName,
                        g.FloorName,
                        g.Capacity,
                        g.Occupied,
                        g.RemainingCount,
                        g.Reservations
                    })
                    .ToList();

                    foreach (var room in distinctRooms)
                    {
                        <tr data-bs-toggle="collapse" data-bs-target="#room-@room.Id" class="clickable-row">
                            <td><i class="fas fa-chevron-down"></i> @room.Name</td>
                            <td>@room.BuildingName</td>
                            <td>@room.BlockName</td>
                            <td>@room.FloorName</td>
                        </tr>

                        var reservationList = room.Reservations.ToList();
                        <tr id="room-@room.Id" class="collapse collapse-content">
                            <td colspan="4">
                                <table class="inner-table">
                                    <thead>
                                        <tr class="capacity-row">
                                            <th colspan="5">
                                                Capacity: @room.Capacity &nbsp;&nbsp; | &nbsp;&nbsp;
                                                Occupied: @room.Occupied &nbsp;&nbsp; | &nbsp;&nbsp;
                                                Remaining: @room.RemainingCount
                                            </th>
                                        </tr>
                                        <tr>
                                            <th>Devotee Code</th>
                                            <th>Devotee Name</th>
                                            <th>Check-In</th>
                                            <th>Check-Out</th>
                                            <th>Allotted</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (reservationList.Count > 0)
                                        {
                                            foreach (var res in reservationList)
                                            {
                                                <tr>
                                                    <td>
                                                        <a asp-action="AddOrEdit" asp-controller="Devotee"
                                                           asp-route-id="@res.Devotee.Id"
                                                           class="devotee-link">
                                                            @res.Devotee.Code
                                                        </a>
                                                    </td>
                                                    <td>@res.Devotee.Name</td>
                                                    <td>@res.FromDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@res.ToDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@res.Allocated</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="no-records">No Records Found</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $('.clickable-row').on('click', function () {
            $('.collapse.show').not($(this).next('.collapse')).collapse('hide');
            $(this).next('.collapse').collapse('toggle');
        });

        $('.collapse').on('shown.bs.collapse', function () {
            $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        }).on('hidden.bs.collapse', function () {
            $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });
        
               function submitReport(action) {
            document.getElementById('actionButton').value = action;
            document.getElementById('reportForm').submit();
        }

        // Add hover effect: slightly darken background on hover
        document.querySelectorAll('.dropdown-item').forEach(item => {
            const bg = item.style.backgroundColor;
            const color = item.style.color;

            item.addEventListener('mouseenter', () => {
                item.style.filter = 'brightness(85%)'; // darken
            });
            item.addEventListener('mouseleave', () => {
                item.style.filter = 'none';
            });
        });
    </script>
}
