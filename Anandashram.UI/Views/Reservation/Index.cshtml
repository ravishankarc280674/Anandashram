
@model IEnumerable<Room>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;

    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}

<div class="container-fluid btn-group">
    <div class="col-10">
        <h3>Reservation List</h3>
    </div>
    @* <div class="col-2 justify-content-end">
        <p>
            <a asp-action="Create" class="btn btn-success">Create New</a>
        </p>
    </div> *@
</div>

<div class="row">
    <div class="col-12">
        <partial name="_PagerSearchOnly" model="@pager" />
    </div>
</div>
<div class="col-12">
    <table id="tblRoomList" class="table col-4">
        <thead>
            <tr class="fa-border-all">
                <th class="row-cols-sm-2 text-center" style="background:#d4d454">
                    Room
                </th>
                <th class="row-cols-sm-2 text-center" style="background:#d4d454">
                    Building
                </th>
                <th class="row-cols-sm-2 text-center" style="background:#d4d454">
                    Block
                </th>
                <th class="row-cols-sm-2 text-center" style="background:#d4d454">
                    Floor
                </th>
                
            </tr>
        </thead>
        <tbody>
            @{
                var distinctRooms = Model.DistinctBy(p => p.Id).Select(g => new { g.Id,g.Name,g.BuildingName,g.BlockName,g.FloorName,g.Capacity,g.Occupied,g.RemainingCount,g.Reservations }).ToList(); //no of buildings
                @foreach (var distinctRoom in distinctRooms)
                {
                    string trHtml = $"<tr data-bs-toggle='collapse' data-bs-target=\"#room-{distinctRoom.Id}\"  aria-expanded='false' aria-controls=\"collapseRow-{distinctRoom.Id}\" class='clickable-row'>";
                    @Html.Raw(trHtml);
                    var roomsRowsList = Model.Where(p => p.Id == distinctRoom.Id).ToList();
                    <td class="text-center">
                    <i class="fas fa-chevron-down"></i>@distinctRoom.Name
                    </td>
                     <td class="text-center">
                    @distinctRoom.BuildingName
                    </td>
                    <td class="text-center">
                        @distinctRoom.BlockName
                    </td>
                    <td class="text-center">
                        @distinctRoom.FloorName
                    </td>
                    @Html.Raw("</tr>");
                var reservationList = distinctRoom.Reservations.ToList();
                    <tr id="#room-@distinctRoom.Id" class="collapse">
                    <td colspan="4">
                    <!-- Content to show on click for row 1 -->
                    <table class="table table-sm">
                        <thead>
                                <tr class="fa-border-all" style="background:#f16161">
                                    <th class="text-center  text-white" colspan="4" style="padding-left:40px;">
                                        Capacity : @distinctRoom.Capacity &nbsp;&nbsp;&nbsp;&nbsp; - &nbsp;&nbsp;&nbsp;&nbsp;
                                        Occupied: @distinctRoom.Occupied  &nbsp;&nbsp;&nbsp;&nbsp;  - &nbsp;&nbsp;&nbsp;&nbsp;  Remaining: @distinctRoom.RemainingCount
                                    </th>
                                </tr>
                                <tr class="fa-border-all" style="background:#1cfcfc">
                                    <th class="text-center" style="padding-left:40px;">Devotee Code</th>
                                    <th class="text-center" style="padding-left:40px;">Devotee Name</th>
                                    <th class="text-center" style="padding-left:40px;">Check-In</th>
                                    <th class="text-center" style="padding-left:40px;">Alloted</th>

                            </tr>
                        </thead>
                        <tbody>
                                    @{
                                        if (reservationList.Count > 0)
                                        {
                                            foreach (var reservation in reservationList)
                                            {
                                            @Html.Raw($"<tr style=\"background:#f5d1f1\">")
                                            ;
                                        <td>
                                            <a asp-action="AddOrEdit" asp-controller="Devotee" asp-route-id="@reservation.Devotee.Id">
                                                <span style="color: purple" asp-controller="Devotee" asp-action="AddOrEdit" asp-route-id="@reservation.Devotee.Id">@reservation.Devotee.Code</span>
                                            </a>
                                        </td>
                                                    <td>@reservation.Devotee.Name</td>
                                                    <td>@reservation.FromDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@reservation.Allocated</td>
                                                 @Html.Raw("</tr>");
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                        <td colspan="4" class="text-center fw-bold" style="background:#f5d1f1">No Records Found</td>
                                            </tr>
                                        }

                                }
                                </tbody>
                                </table>
                    </td>
                    </tr>
                }
            }
        </tbody>
    <tbody>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
           $('.clickable-row').on('click', function () {
        // Collapse any other open detail rows
        $('.collapse.show').not($(this).next('.collapse')).collapse('hide');

        // Toggle the clicked row's detail
        $(this).next('.collapse').collapse('toggle');
    });

    // Optional: Change icon on expand/collapse
    $('.collapse').on('shown.bs.collapse', function () {
        $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    }).on('hidden.bs.collapse', function () {
        $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });
        $('.clickable-row-block').on('click', function () {
            // Collapse any other open detail rows
            $('.collapse-block.show').not($(this).next('.collapse-block')).collapse('hide');
            // Toggle the clicked row's detail

            $(this).next('.collapse-block').collapse('toggle');
        });

        // Optional: Change icon on expand/collapse
        $('.collapse-block').on('shown.bs.collapse-block', function () {
            $(this).prev('.clickable-row-block').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        }).on('hidden.bs.collapse-block', function () {
            $(this).prev('.clickable-row-block').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });

                  $('.clickable-row-floor').on('click', function () {
                // Collapse any other open detail rows
                        $('.collapse-floor.show').not($(this).next('.collapse-floor')).collapse('hide');
                // Toggle the clicked row's detail

                    $(this).next('.collapse-floor').collapse('toggle');
            });

            // Optional: Change icon on expand/collapse
                $('.collapse-floor').on('shown.bs.collapse-floor', function () {
                    $(this).prev('.clickable-row-floor').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
                }).on('hidden.bs.collapse-floor', function () {
                    $(this).prev('.clickable-row-floor').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            });
    </script>
}
