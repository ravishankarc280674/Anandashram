@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reservation Timeline Chart";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">

        <!-- THEME HEADER (DANGER) -->
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-chart-bar me-2"></i> Reservation Timeline
            </h4>
        </div>

        <div class="card-body">

            <!-- FILTER SECTION -->
            <form class="row g-4 align-items-end mb-4">

                <!-- Start Date -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar-alt text-danger me-1"></i> Start Date:
                    </label>
                    <input type="date" id="startDate"
                           class="form-control border-danger shadow-sm" />
                </div>

                <!-- End Date -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar text-danger me-1"></i> End Date:
                    </label>
                    <input type="date" id="endDate"
                           class="form-control border-danger shadow-sm" />
                </div>

                <!-- Buttons -->
                <div class="col-md-6 d-flex align-items-end gap-2 mt-2">

                    <button type="button"
                            onclick="loadTimeline()"
                            class="btn btn-danger fw-bold px-4 shadow-sm">
                        <i class="fas fa-play-circle me-1"></i> Generate
                    </button>

                    <button type="button"
                            onclick="exportPdf()"
                            class="btn btn-primary fw-bold px-4 shadow-sm">
                        <i class="fas fa-file-pdf me-1"></i> Export PDF
                    </button>

                    <button type="button"
                            onclick="exportExcel()"
                            class="btn btn-warning fw-bold px-4 shadow-sm">
                        <i class="fas fa-file-excel me-1"></i> Export Excel
                    </button>

                </div>

            </form>

            <!-- TIMELINE CHART -->
            <div class="report-container border border-3 border-danger rounded p-3">

                <div id="timelineWrapper"
                     style="width:100%; height:1540px; overflow-x:auto;">

                    <canvas id="timelineChart"></canvas>

                </div>

            </div>

        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/lib/chart.js/chart.umd.js"></script>
<script src="~/js/chartjs-adapter-date-fns.umd.js"></script>
<script src="/js/reservation-timeline.js"></script>

<style>
    .card-header {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: 0.5px;
    }

    .report-container {
        background-color: #ffffff;
        min-height: 500px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease-in-out;
    }

        .report-container:hover {
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.3);
        }

    .btn-danger, .btn-primary, .btn-warning {
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-danger:hover, .btn-primary:hover, .btn-warning:hover {
            transform: scale(1.03);
        }
</style>
