@{
    ViewData["Title"] = "Reservation Timeline Chart";
}
<style>
    .card-header {
        background: linear-gradient(90deg, #dc3545 0%, #bb2d3b 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: .5px;
    }

    #timelineWrapper {
        background: #ffffff;
        transition: 0.2s;
    }

        #timelineWrapper:hover {
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.25);
        }

    .btn-danger {
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
            transform: scale(1.04);
        }
        </style>
@{
    ViewData["Title"] = "Reservation Timeline Chart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Reservation Timeline Chart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-chart-bar me-2"></i> Reservation Timeline
            </h4>
        </div>

        <div class="card-body">

            <form class="row g-4 align-items-end mb-4">
                <!-- Buildings Multi Select -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary">
                        <i class="fas fa-building text-primary me-2"></i> Building(s)
                    </label>

                    <div class="dropdown w-100">
                        <button class="form-control text-start dropdown-toggle shadow-sm"
                                type="button"
                                id="buildingDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            All Buildings Selected
                        </button>

                        <ul class="dropdown-menu w-100 p-2"
                            style="max-height:260px; overflow-y:auto">

                            <!-- Select All -->
                            <li class="dropdown-item">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="selectAllBuildings"
                                           checked>
                                    <label class="form-check-label fw-bold">
                                        Select All
                                    </label>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            @* Example: replace with your real building list *@
                            @foreach (var b in ViewBag.Buildings as List<Building>)
                            {
                                <li class="dropdown-item">
                                    <div class="form-check">
                                        <input class="form-check-input building-checkbox"
                                               type="checkbox"
                                               value="@b.Id"
                                               checked>
                                        <label class="form-check-label">@b.Name</label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Start Date -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar-alt text-success me-2"></i> Start Date
                    </label>
                    <input type="date" id="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control border-success shadow-sm" />
                </div>

                <!-- End Date -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar-alt text-success me-2"></i> End Date
                    </label>
                    <input type="date" id="endDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                    class="form-control border-success shadow-sm" />
                </div>

                <!-- Generate Button -->
                <div class="col-md-2 text-center">
                    <button type="button"
                            onclick="loadTimeline()"
                            class="btn btn-success fw-bold px-4 shadow-sm">
                        <i class="fas fa-play-circle me-1"></i> Generate
                    </button>
                </div>

            <!-- Print + back barra -->
            <div id="toolbarContainer" class="col-md-4" style="display:none">
                <div class="d-flex justify-content-end">

                    <button type="button"
                            onclick="printChart()"
                            class="btn btn-outline-danger fw-bold me-2">
                        <i class="fas fa-print me-1"></i> Print
                    </button>

                    <button type="button"
                            onclick="exportPdf()"
                            class="btn btn-outline-primary fw-bold me-2">
                        <i class="fas fa-file-pdf me-1"></i> Save PDF
                    </button>

                    <button type="button"
                            onclick="exportExcel()"
                            class="btn btn-outline-success fw-bold">
                        <i class="fas fa-file-excel me-1"></i> Save Excel
                    </button>

                </div>
            </div>
            </form>

            <div id="timelineWrapper"
                 class="border border-3 border-success rounded p-3 shadow-sm"
                 style="width:100%; height:1540px; overflow-x:auto;">
                <canvas id="timelineChart"></canvas>
            </div>

        </div>
    </div>
</div>

<script src="~/lib/chart.js/chart.umd.js"></script>
<script src="~/js/chartjs-adapter-date-fns.umd.js"></script>
<script src="/js/reservation-timeline.js"></script>

<script>
    function handleTimelineGenerate() {
        let type = $("input[name='reportType']:checked").val();

        if (type === "screen") {
            loadTimeline();
        }
        else if (type === "pdf") {
            exportPdf();
        }
        else if (type === "excel") {
            exportExcel();
        }
    }
</script>
