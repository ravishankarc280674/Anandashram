
@model IEnumerable<Room>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;

    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}

<div class="container-fluid btn-group">
    <div class="col-10">
        <h3>Reservation Summary</h3>
    </div>
    <div class="col-2 justify-content-end">
        <p>
            <a asp-action="Create" class="btn btn-success">Create New</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <partial name="_PagerSearchOnly" model="@pager" />
    </div>
</div>
<div class="col-12">
    <table id="tblRoomList" class="table col-4">
        <thead>
            <tr class="fa-border-all" style="background:#d4d454">
                <th class="row-cols-sm-2 text-start">
                    Building
                </th>
                
            </tr>
        </thead>
        <tbody>
            @{
                var distinctBuildings = Model.DistinctBy(p => p.BuildingId).Select(g => new { g.BuildingId, g.BuildingName }).ToList(); //no of buildings
                @foreach (var distinctBuild in distinctBuildings)
                {
                    string trHtml = $"<tr data-bs-toggle='collapse' data-bs-target=\"#block-{distinctBuild.BuildingId}\"  aria-expanded='false' aria-controls=\"collapseRow-{distinctBuild.BuildingId}\" class='clickable-row'>";
                    @Html.Raw(trHtml);
                     var buildingRowsList = Model.Where(p => p.BuildingId == distinctBuild.BuildingId).ToList();
                <td class="text-start">
                            @distinctBuild.BuildingName
                           <i class="fas fa-chevron-down"></i>
                    </td>
                @Html.Raw("</tr>");

                <tr id="#block-@distinctBuild.BuildingId" class="collapse">
                    <td>
        @{
            var distinctBlocks = buildingRowsList.DistinctBy(p => p.BlockId).Select(g => new { g.BuildingId, g.BlockId, g.BlockName });

                        <!-- Content to show on click for row 1 -->
                        <table class="table table-sm">
                            <thead>
                                    <tr class="fa-border-all" style="background:#1cfcfc">
                                        <th class="text-start" style="padding-left:40px;">Block</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var distinctBlock in distinctBlocks)
                                {
                                        string trHtmlblock = $"<tr data-bs-toggle='collapse-block' data-bs-target=\"#floor-{distinctBlock.BlockId}\" aria-expanded='false' aria-controls=\"collapseRow-{distinctBlock.BlockId}\" class='clickable-row-block'>";
                                     @Html.Raw(trHtmlblock);
                                            var blockRowsList = Model.Where(p => p.BlockId == distinctBlock.BlockId && p.BuildingId == distinctBlock.BuildingId).ToList();
                                    <td class="text-start" style="padding-left:40px">
                                        @distinctBlock.BlockName
                                            <i class="fas fa-chevron-down"></i>
                                         </td> 
                                    @Html.Raw("</tr>");
                                    <tr id="#floor-@distinctBlock.BlockId" class="collapse-block">
                                        <td>
                                            @{
                                                    var distinctFloors = blockRowsList.DistinctBy(p => p.FloorId).Select(g => new { g.BuildingId, g.BlockId, g.FloorId, g.FloorName });
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr class="fa-border-all" style="background:#f16161">
                                                            <th class="text-start" style="padding-left: 80px;">Floor</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                         @foreach (var distinctFloor in distinctFloors)
                                                                {
                                                                   string trHtmlfloor = $"<tr data-bs-toggle='collapse-floor' data-bs-target=\"#room-{distinctFloor.FloorId}\" aria-expanded='false' aria-controls=\"collapseRow-{distinctFloor.FloorId}\" class='clickable-row-floor'>";
                                                                   @Html.Raw(trHtmlfloor);
                                                        <td class="text-start" style="padding-left:80px">
                                                            @distinctFloor.FloorName
                                                                        <i class="fas fa-chevron-down"></i>
                                                                    </td>
                                                                    @Html.Raw("</tr>");
                                                                    var floorRoomsList = Model.Where(p => p.BlockId == distinctBlock.BlockId && p.BuildingId == distinctBlock.BuildingId && p.FloorId == distinctFloor.FloorId).ToList();
                                                        <tr id="#floor-@distinctBlock.BlockId" class="collapse-block" style="padding-left:120px">
                                                            <td>
                                                                @{
                                                                    //var distinctRooms = floorRoomsList.DistinctBy(p => p.FloorId).Select(g => new { g.BuildingId, g.BlockId, g.FloorId, g.FloorName,g.Id,g.Name,g.Capacity });
                                                                    <table class="table table-sm">
                                                                        <thead>
                                                                            <tr class="fa-border-all" style="background:#5a5afa">
                                                                                <th class="text-start" style="padding-left:120px">Room</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var distinctRoom in floorRoomsList)
                                                                                        {
                                                                                            string trHtmlroom = $"<tr data-bs-toggle='collapse-room' data-bs-target=\"#room-{distinctRoom.Id}\" aria-expanded='false' aria-controls=\"collapseRow-{distinctRoom.Id}\" class='clickable-row-room'>";
                                                                                            @Html.Raw(trHtmlroom);
                                                                                            <td class="text-start" style="padding-left:120px">
                                                                                                @distinctRoom.Name
                                                                                                <i class="fas fa-chevron-down"></i>
                                                                                            </td>
                                                                                            @Html.Raw("</tr>");
                                                                                        }
                                                                                    </tbody>
                                                                            </table>
                                                                }
                                                            </td>
                                                        </tr>
                                                }
                                                                                    </tbody>
                                                </table>
                                             }

                                        </td>
                                    </tr>
                                }
                           </tbody>
                       </table>
                }
                </td>
                </tr>
            }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
           $('.clickable-row').on('click', function () {
        // Collapse any other open detail rows
        $('.collapse.show').not($(this).next('.collapse')).collapse('hide');

        // Toggle the clicked row's detail
        $(this).next('.collapse').collapse('toggle');
    });

    // Optional: Change icon on expand/collapse
    $('.collapse').on('shown.bs.collapse', function () {
        $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
    }).on('hidden.bs.collapse', function () {
        $(this).prev('.clickable-row').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
    });
        $('.clickable-row-block').on('click', function () {
            // Collapse any other open detail rows
            $('.collapse-block.show').not($(this).next('.collapse-block')).collapse('hide');
            // Toggle the clicked row's detail

            $(this).next('.collapse-block').collapse('toggle');
        });

        // Optional: Change icon on expand/collapse
        $('.collapse-block').on('shown.bs.collapse-block', function () {
            $(this).prev('.clickable-row-block').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
        }).on('hidden.bs.collapse-block', function () {
            $(this).prev('.clickable-row-block').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
        });

                  $('.clickable-row-floor').on('click', function () {
                // Collapse any other open detail rows
                        $('.collapse-floor.show').not($(this).next('.collapse-floor')).collapse('hide');
                // Toggle the clicked row's detail

                    $(this).next('.collapse-floor').collapse('toggle');
            });

            // Optional: Change icon on expand/collapse
                $('.collapse-floor').on('shown.bs.collapse-floor', function () {
                    $(this).prev('.clickable-row-floor').find('i').removeClass('fa-chevron-down').addClass('fa-chevron-up');
                }).on('hidden.bs.collapse-floor', function () {
                    $(this).prev('.clickable-row-floor').find('i').removeClass('fa-chevron-up').addClass('fa-chevron-down');
            });
    </script>
}
