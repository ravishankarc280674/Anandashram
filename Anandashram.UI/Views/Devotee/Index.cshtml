@model IEnumerable<Devotee>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = "Devotee - List";

    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];
        TempData["CurrentPage"] = pg;
    }

    PageModel pager = ViewBag.Pager;
    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}

<div class="container-fluid btn-group mb-3">
    <div class="col-10">
        <h3 class="mb-0 text-success">
            <i class="fas fa-users"></i> @currentModel - List
        </h3>
    </div>
    <div class="col-2 text-end">
        <a asp-action="AddOrEdit" class="btn btn-success btn-sm shadow-sm">
            <i class="fas fa-plus-circle"></i> Create New
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <partial name="_PagerDevoteeOnly" model="@pager" />
    </div>
</div>

@if (pager.ViewType == "Grid")
{
    <div class="col-12 tbl-container">
        <table id="tblDevoteeList" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th class="sticky-col first-col"></th>
                    <th class="sticky-col second-col">
                        <i class="@sortModel.GetColumn("code").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("code").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Code</a>
                    </th>
                    <th>
                        <i class="@sortModel.GetColumn("name").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("name").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Name</a>
                    </th>
                    <th>
                        <i class="@sortModel.GetColumn("devoteecategoryname").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("devoteecategoryname").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Devotee Category</a>
                    </th>
                    <th>
                        <i class="@sortModel.GetColumn("startdate").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("startdate").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Registration Date</a>
                    </th>
                    @* <th>
                        <i class="@sortModel.GetColumn("enddate").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("enddate").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">End Date</a>
                    </th> *@
                    <th>
                        <i class="@sortModel.GetColumn("mobile").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" style="color:white" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("mobile").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Mobile</a>
                    </th>
                    <th>
                        <i class="@sortModel.GetColumn("email").SortIcon"></i>
                        <a class="text-white text-decoration-none fw-bold" asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("email").SortExpression"
                           asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize"
                           asp-route-Closed="@ViewBag.Closed" asp-route-view="@ViewBag.view">Email</a>
                    </th>
                    <th class="text-white fw-bold">Document</th>
                    <th class="text-white fw-bold">No. of Devotees</th>
                    <th class="sticky-col last-col fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        string rowClass = "";
                        if (item.Closed == true && string.IsNullOrEmpty(item.ReopenedCode))
                        {
                            rowClass = "bg-success";
                        }
                        if (item.Closed == true && !string.IsNullOrEmpty(item.ReopenedCode))
                        {
                            rowClass = "bg-warning";
                        }
                        <tr>
                            <td class="sticky-col first-col" style="background:#94a09c">
                                <img src="@Url.Action("GetImage", "Devotee", new { fileName = item.Code })"
                                     width="35" height="35" class="rounded-circle" />
                            </td>
                            <td class="sticky-col second-col" style="background:#94a09c">
                                @if (!item.Closed)
                                {
                                    <a asp-action="AddOrEdit" asp-route-id="@item.Id" class="devotee-link">@item.Code</a>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="devotee-link">@item.Code</a>
                                }
                            </td>
                            <td class="@rowClass">@item.Name</td>
                            <td class="@rowClass">@item.DevoteeCategoryName</td>
                            <td class="@rowClass">@item.StartDate.ToString("dd/MM/yyyy")</td>
                           @*  <td class="@rowClass">@item.EndDate.ToString("dd/MM/yyyy")</td> *@
                            <td class="@rowClass">@item.Mobile</td>
                            <td class="@rowClass">@item.Email</td>
                            <td class="@rowClass">
                                <span data-bs-toggle="tooltip"
                                      data-bs-placement="bottom"
                                      data-bs-html="true"
                                      title="@item.Document"
                                      style="cursor: pointer; display:inline-block; width:100%;">
                                    <i class="fa-solid fa-file-lines"></i>
                                </span>
                            </td>
                            <td class="@rowClass">@item.NoOfPeople</td>
                            <td class="sticky-col last-col" style="background:#94a09c">
                                <div class="btn-group">
                                    @if (!item.Closed)
                                    {
                                        <a asp-action="AddOrEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="View Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    }

                                    <form asp-controller="Report" asp-action="ShowReport"
                                          asp-route-reportType="DevoteeDetail" asp-route-id="@item.Id"
                                          method="post" class="d-flex gap-2">
                                        <button type="submit" class="btn btn-sm btn-outline-success" name="actionButton" value="Screen" title="Screen">
                                            <i class="fa fa-print"></i>
                                        </button>
                                        <button type="submit" class="btn btn-sm btn-outline-danger" name="actionButton" value="Pdf" title="Download PDF">
                                            <i class="fa-solid fa-file-pdf"></i>
                                        </button>
                                        <button type="submit" class="btn btn-sm btn-outline-success" name="actionButton" value="Excel" title="Download Excel">
                                            <i class="fa-solid fa-file-excel"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="11" class="text-center text-muted">No Records Found</td></tr>
                }
            </tbody>
        </table>
    </div>
}
else
{


    <div class="container mt-4">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-12 col-md-4">
                        <div class="card h-100 shadow-sm border-0">
                            <!-- Header -->
                            <div class="card-header text-center fw-bold text-white" style="background-color:darkred;">
                                @item.Name
                            </div>

                            <!-- Body -->
                            <div class="card-body card-body-bordered">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4 fw-semibold">Code:</dt>
                                    <dd class="col-sm-8">
                                        @if (!item.Closed)
                                        {
                                            <a asp-action="AddOrEdit" asp-route-id="@item.Id"
                                               class="fw-bold text-decoration-none code-link">
                                                @item.Code
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="fw-bold text-decoration-none code-link-closed">
                                                @item.Code
                                            </a>
                                        }
                                    </dd>

                                    <dt class="col-sm-12 text-center">
                                        <img src="@Url.Action("GetImage", "Devotee", new { fileName = @item.Code })"
                                             class="img-thumbnail shadow-sm" style="max-width: 250px; height: 150px; object-fit: cover;" />
                                    </dt>

                                    <dt class="col-sm-4 fw-semibold">Category:</dt>
                                    <dd class="col-sm-8">@item.DevoteeCategoryName</dd>

                                    <dt class="col-sm-4 fw-semibold">Mobile:</dt>
                                    <dd class="col-sm-8">@item.Mobile</dd>

                                    <dt class="col-sm-4 fw-semibold">Document</dt>
                                    <dd class="col-sm-8">
                                        <span data-bs-toggle="tooltip"
                                              data-bs-placement="bottom"
                                              data-bs-html="true"
                                              title="@item.Document"
                                              style="cursor: pointer; display:inline-block; width:100%;">
                                            <i class="fa-solid fa-file-lines"></i>
                                        </span>
                                    </dd>

                                </dl>
                            </div>

                            <!-- Footer -->
                            <div class="card-footer bg-light d-flex justify-content-center gap-2">
                                @if (!item.Closed)
                                {
                                    <a asp-action="AddOrEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="View Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                }

                                <form asp-controller="Report" asp-action="ShowReport"
                                      asp-route-reportType="DevoteeDetail" asp-route-id="@item.Id"
                                      method="post" target="_blank" class="d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-outline-success" name="actionButton" value="Screen" title="Screen">
                                        <i class="fa fa-print"></i>
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" name="actionButton" value="Pdf" title="Download PDF">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    No records found.
                </div>
            }
        </div>
    </div>
}
<div class="row mt-3">
    <div class="col-12">
        <partial name="_BottomBar" model="@pager" />
    </div>
</div>
