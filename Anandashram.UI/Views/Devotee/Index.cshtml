@model IEnumerable<Devotee>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] =  "Devotee - List";
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;

    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}

<div class="container-fluid btn-group">
    <div class="col-10">
        <h3>Devotee - List</h3>
    </div>
    <div class="col-2 justify-content-end">
        <p>
            <a asp-action="AddOrEdit" class="btn btn-success"><i class="fas fa-random"></i>Create New</a>
        </p>
    </div>
</div>
<br />
<div class="row">
    <div class="col-12">
        <partial name="_PagerDevoteeOnly" model="@pager" />
    </div>
</div>

<table id="tblBlockList" class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                <i class="@sortModel.GetColumn("code").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("code").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Code</a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("code").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("code").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Name</a>
            </th>
           
            <th>
                <i class="@sortModel.GetColumn("devoteecategoryname").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" sp-route-sortExpression="@sortModel.GetColumn("devoteecategoryname").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Devotee Category</a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("startdate").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" sp-route-sortExpression="@sortModel.GetColumn("startdate").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Start Date</a>
            </th>
             <th>
                <i class="@sortModel.GetColumn("enddate").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" sp-route-sortExpression="@sortModel.GetColumn("enddate").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">End Date</a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("mobile").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("mobile").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Mobile</a>
            </th>
            <th>
                <i class="@sortModel.GetColumn("email").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("email").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Email</a>
            </th>
            <th>
                &nbsp;
            </th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="image"><img src="@Url.Action("GetImage", "Devotee", new { fileName = item.Code })" width="40" height="30" class="rounded-circle" /></td>
                    <td class="Code">
                        <a asp-action="AddOrEdit" asp-route-id="@item.Id">
                            <span style="color: purple" asp-action="Edit" asp-route-id="@item.Id">@item.Code</span>
                        </a>
                    </td>
                    <td class="Name">
                        <span>@item.Name</span>
                    </td>
                    <td class="DevoteeCategoryName">
                        <span>@item.DevoteeCategoryName</span>
                    </td>
                    <td class="StartDate">
                        <span>@item.StartDate</span>
                    </td>
                    <td class="EndDate">
                        <span>@item.EndDate</span>
                    </td>
                    <td class="Mobile">
                        <span>@item.Mobile</span>
                    </td>
                    <td class="Email">
                        <span>@item.Email</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="AddOrEdit" asp-route-id="@item.Id">
                                <span class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-edit" aria-hidden="true" title="Edit"></i>
                                </span>
                            </a>

                            <a asp-action="Details" asp-route-id="@item.Id">
                                <span class="btn btn-sm btn-outline-dark">
                                    <i class="fa fa-eye" aria-hidden="true" title="Details"></i>
                                </span>
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id">
                                <span class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash" aria-hidden="true" title="Delete"></i>
                                </span>
                            </a>

                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">No Records Found</td>
            </tr>
        }
    </tbody>
</table>
<div class="row">
    <div class="col-12">
        <partial name="_BottomBar" model="@pager" />
    </div>
</div>
 