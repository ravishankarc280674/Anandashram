@model Anandashram.Models.Devotee
@{
    ViewData["Title"] = "Devotee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Devotee Details</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Code)</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Name)</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.DevoteeCategoryName)</dd>

                <dt class="col-sm-3">Mobile</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Mobile)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Email)</dd>

                <dt class="col-sm-3">Docs (Aadhar / PAN / ...)</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Document))
                    {
                        <a href="@Url.Content(Model.Document)" target="_blank" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-download"></i> View / Download
                        </a>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No document uploaded</span>
                    }
                </dd>

                <dt class="col-sm-3">Address Line 1</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.AddressLine1)</dd>

                <dt class="col-sm-3">Address Line 2</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.AddressLine2)</dd>

                <dt class="col-sm-3">State</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.State)</dd>

                <dt class="col-sm-3">Country</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Country)</dd>

                <dt class="col-sm-3">Pin Code</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.PinCode)</dd>

                <dt class="col-sm-3">Check-In Date</dt>
                <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy")</dd>

                <dt class="col-sm-3">Check-Out Date</dt>
                <dd class="col-sm-9">@Model.EndDate.ToString("dd-MM-yyyy")</dd>

                <dt class="col-sm-3">Number of People</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.NoOfPeople)</dd>

                <dt class="col-sm-3">Additional Information</dt>
                <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>
            </dl>

            <hr />

            <!-- Reservations List -->
            <h5 class="text-success mb-3">Reservation Details</h5>
            @if (Model.Reservations != null && Model.Reservations.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-success">
                            <tr>
                                <th>Room</th>
                                <th>Building</th>
                                <th>Block</th>
                                <th>Floor</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>No. of Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Reservations)
                            {
                                <tr>
                                    <td>@r.Room?.Name</td>
                                    <td>@r.Room?.Building?.Name</td>
                                    <td>@r.Room?.Block?.Name</td>
                                    <td>@r.Room?.Floor?.Name</td>
                                    <td>@r.FromDate.ToString("dd-MM-yyyy")</td>
                                    <td>@r.ToDate.ToString("dd-MM-yyyy")</td>
                                    <td>@((r.ToDate - r.FromDate).Days)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-muted fst-italic mb-4">No reservations available</div>
            }

            <div class="text-end">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>
