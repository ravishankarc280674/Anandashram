@model Anandashram.Models.Devotee

@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = currentModel + (Model.Id == 0 ? " - Add" : " - Edit");
    Layout = "~/Views/Shared/_Layout.cshtml";

    AddFile addFile = ViewBag.AddFile;
    var uploadedFiles = ViewBag.UploadedFiles;
    if (Model.Id != 0)
    {
        addFile.DevoteeId = Model.Id;
        addFile.DevoteeCode = Model.Code;
        ViewBag.AddFile = addFile;
    }
    int pg = TempData["CurrentPage"] != null ? (int)TempData["CurrentPage"] : 1;
    var roomsList = ViewBag.RoomsList;
    string searchText = ViewBag.SearchText;
}

<style>
    .section-card {
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        box-shadow: 0 3px 6px rgba(0,0,0,0.08);
        margin-bottom: 1.5rem;
        background-color: #fff;
    }

    .section-header {
        background-color: #d9f2dc;
        color: #064b0c;
        font-weight: 600;
        padding: 0.75rem 1rem;
        border-radius: 10px 10px 0 0;
        font-size: 1.05rem;
    }

    .wrap-text-cell {
        white-space: normal;
        word-break: break-word;
    }

    .btn-success {
        background-color: #1f6f2e !important;
        border-color: #1f6f2e !important;
    }

    .btn-outline-success {
        color: #1f6f2e !important;
        border-color: #1f6f2e !important;
    }

        .btn-outline-success:hover {
            background-color: #1f6f2e !important;
            color: #fff !important;
        }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .table thead {
        background-color: #e9f6ea;
        color: #064b0c;
        font-weight: 600;
    }

    .table tfoot {
        background-color: #f4f9f4;
        font-weight: 600;
    }

    .form-section {
        margin-top: 1.5rem;
    }
</style>

<div class="container-fluid mt-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-success">@ViewData["Title"]</h4>
        <a class="btn btn-secondary" asp-action="index"
           asp-route-pg="@TempData.Peek("CurrentPage")" asp-route-SearchText="@ViewBag.SearchText">
            <i class="fa fa-arrow-left"></i> Back
        </a>
    </div>

    <div class="card p-4">
        <form asp-action="AddOrEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Hidden Fields *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="ModifiedBy" />
            <input type="hidden" asp-for="ModifiedDate" />
            <input type="hidden" asp-for="Closed" />

            @* Profile Section *@
            @if (Model.Id != 0)
            {
                <div class="section-card">
                    <div class="section-header">Profile Overview</div>
                    <div class="p-3 row">
                        <div class="col-md-5 d-flex">
                            <img id="profilePic"
                                 src="@Url.Action("GetImage", "Devotee", new { fileName = Model.Code })"
                                 class="img-thumbnail shadow-sm"
                                 style="max-width: 220px; height:auto; cursor:pointer;" />
                            <div>
                                <div class="fs-5 fw-bold text-success">@Html.DisplayFor(model => model.Name)</div>
                                <div class="font-weight-bold fs-2 text-danger">@Html.DisplayFor(model => model.Code)</div>
                                <a data-bs-toggle="modal" data-bs-target="#webcamModal"
                                   data-item-Id="@Model.Id" data-item-Code="@Model.Code"
                                   class="btn btn-sm btn-outline-success mt-2">
                                    <i class="fa-solid fa-camera"></i> Show Camera
                                </a>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-bold text-success fs-6">Document List</div>
                                <a data-bs-toggle="modal" data-bs-target="#uploadModal" class="btn btn-sm btn-outline-success">
                                    <i class="fa fa-plus"></i> Add Document
                                </a>
                            </div>
                            <table class="table table-sm mt-2">
                                <tbody>
                                    @if (uploadedFiles != null)
                                    {
                                        @foreach (var fileUpload in uploadedFiles)
                                        {
                                            <tr>
                                                <td class="col-sm-8">@fileUpload.FileName</td>
                                                <td>
                                                    <a href="@Url.Action("GetDocument", new { fileName = fileUpload.FileName, filePath = fileUpload.FilePath })"
                                                       class="btn btn-sm btn-outline-secondary">
                                                        <i class="fa fa-download"></i>
                                                    </a>
                                                </td>
                                                <td>
                                                    <a asp-action="DeleteDocument"
                                                       asp-route-filePath="@fileUpload.FilePath"
                                                       asp-route-Id="@fileUpload.DevoteeId"
                                                       onsubmit="return jQueryAjaxDelete(this);"
                                                       class="btn btn-sm btn-outline-danger">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="3" class="text-muted">No Documents Uploaded</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @* Form Section *@
            <div class="section-card form-section">
                <div class="section-header">Devotee Details</div>
                <div class="p-3">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DevoteeCategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="DevoteeCategoryId" class="form-select" asp-items="ViewBag.DevoteeCategoryId"></select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input type="date" asp-for="StartDate" class="form-control" />
                        </div>
                        <div class="col-md-6" style="display:none">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input type="date" asp-for="EndDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NoOfPeople" class="form-label fw-semibold"></label>
                            <input asp-for="NoOfPeople" class="form-control" type="number" min="1" max="999" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label asp-for="Document" class="form-label fw-semibold"></label>
                            <input asp-for="Document" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="AddressLine1" class="form-label fw-semibold"></label>
                            <input asp-for="AddressLine1" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddressLine2" class="form-label fw-semibold"></label>
                            <input asp-for="AddressLine2" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label fw-semibold"></label>
                            <input asp-for="State" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Country" class="form-label fw-semibold"></label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PinCode" class="form-label fw-semibold"></label>
                            <input asp-for="PinCode" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Mobile" class="form-label fw-semibold"></label>
                            <input asp-for="Mobile" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            @* Buttons *@
            <div class="text-center mt-4">
                @if (!Model.Closed)
                {
                    <button type="submit" name="actionButton" value="Submit" class="btn btn-success me-2">Submit Devotee Details</button>
                }
                @if (Model.Id != 0 && !Model.Closed)
                {
                    <button type="submit" name="actionButton" value="Closed" class="btn btn-danger me-2">
                    Close Devotee Details </button>
                }
                @if (Model.Id != 0 && String.IsNullOrEmpty(Model.ReopenedCode) && Model.Closed)
                {
                    <button type="submit" name="actionButton" value="Reopen" class="btn btn-info me-2">Reopen Devotee Details</button>
                }
            </div>
        </form>
    </div>

    @* Webcam Modal *@
    <div id="webcamModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Upload Profile Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <partial name="_UploadProfilePic" model="@Model" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    @* Document Upload Modal *@
    <div id="uploadModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Upload Document / Picture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <partial name="_UploadDocument" model="ViewBag.AddFile" />
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Manage Reservations Section -->
<div class="section-card mt-4">
    <div class="section-header d-flex justify-content-between align-items-center">
        <span>Manage Reservation(s)</span>
        <button class="btn btn-sm btn-outline-success" type="button"
                data-bs-toggle="collapse" data-bs-target="#manageReservationDiv"
                aria-expanded="false" aria-controls="toggleDiv">
            <i class="fa-solid fa-bed"></i> Show / Hide
        </button>
    </div>

    <div class="collapse show" id="manageReservationDiv">
        <div class="p-3">

            <!-- Reservation Filters -->
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Check In Date</label>
                    <input type="date" class="form-control" id="reg-start-date"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Check Out Date</label>
                    <input type="date" class="form-control" id="reg-end-date"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-success w-100"
                            onclick="CloseReservations()">
                        <i class="fa fa-door-closed"></i> Close All Reservation(s)
                    </button>
                </div>
            </div>

            <!-- Reservation Table -->
            <div class="table-responsive">
                <table id="RegTable" class="table table-sm table-hover align-middle border">
                    <thead class="table-success text-dark">
                        <tr>
                            <th style="width:120px;">Room</th>
                            <th>Building</th>
                            <th>Block</th>
                            <th>Floor</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Capacity</th>
                            <th>Remaining</th>
                            <th>Allotted</th>
                            <th>Allot</th>
                            <th class="text-end" style="width:100px;">
                                <button id="btnAddDetailRow" type="button"
                                        class="btn btn-sm btn-outline-success"
                                        onclick="AddItem(this)">
                                    <i class="fa fa-plus"></i> Add
                                </button>
                            </th>
                        </tr>
                    </thead>

                    <tbody id="tableBody">
                        <tr hidden class="rowClass">
                            <td>
                                <select class="form-control dropdown" asp-items="ViewBag.RoomsList"></select>
                            </td>
                            <td><label class="building-label"></label></td>
                            <td><label class="block-label"></label></td>
                            <td><label class="floor-label"></label></td>
                            <td><label class="fromDate-label"></label></td>
                            <td><label class="toDate-label"></label></td>
                            <td><label class="maxCapacity-label"></label></td>
                            <td><label class="remaining-label"></label></td>
                            <td><label class="alreadyAllocate-label">0</label></td>
                            <td>
                                <input type="number" value="0" step="1" min="0" max="100"
                                       class="form-control class-allot" />
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="DeleteItem(this)">
                                    <i class="fa fa-trash"></i> Delete
                                </button>
                            </td>
                        </tr>

                        @for (int i = 0; i < Model.Reservations.Count; i++)
                        {
                            string rowColor = Model.Reservations[i].Closed ? "table-warning" : "";
                            <tr class="@rowColor">
                                <td>
                                    <select asp-for="@Model.Reservations[i].RoomId" class="form-select" asp-items="ViewBag.RoomsList" disabled></select>
                                </td>
                                <td>@Model.Reservations[i].Room.BuildingName</td>
                                <td>@Model.Reservations[i].Room.BlockName</td>
                                <td>@Model.Reservations[i].Room.FloorName</td>
                                <td>@Model.Reservations[i].FromDate.ToString("dd/MM/yyyy")</td>
                                <td>@Model.Reservations[i].ToDate.ToString("dd/MM/yyyy")</td>
                                <td>@Model.Reservations[i].Room.Capacity</td>
                                <td>@Model.Reservations[i].Remaining</td>
                                <td class="total-alloted">@Model.Reservations[i].Allocated</td>
                                <td></td>
                                <td class="text-end">
                                    @if (!Model.Reservations[i].Closed)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success"
                                                onclick="return CloseItem(@Model.Reservations[i].Id, @Model.Reservations[i].DevoteeId)">
                                            <i class="fa fa-lock"></i> Close
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot id="tfoot">
                        <tr class="table-light fw-semibold">
                            <td colspan="8" class="text-end">Total Allocated:</td>
                            <td class="total-fixed text-success"></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Save Button -->
            <div class="text-center mt-3">
                <button type="button" class="btn btn-success px-4"
                        onclick="return saveNewDetails()">
                    <i class="fa fa-save"></i> Update Reservations
                </button>
            </div>
        </div>
        </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded",calculateTotal);
        // $(document).ready(function () {
           $(document).on('change', '.dropdown',function () {
            
                    var id = $(this).val(); // Get selected value
                    var currentRow = $(this).closest('tr');
                              $.ajax({
                                    type: 'POST',
                                    url: '/Devotee/GetSelectedRoom',
                                    data: { Id: id }, // Parameters sent to the controller
                            success: function (Data) {
                                debugger;
                                var room = Data.data;
                                currentRow.find('.building-label').text(room.buildingName);
                                currentRow.find('.block-label').text(room.blockName);
                                currentRow.find('.floor-label').text(room.floorName);
                                currentRow.find('.maxCapacity-label').text(room.capacity);
                                currentRow.find('.remaining-label').text(room.remaining);
                                currentRow.find('.alreadyAllocate-label').text(room.allocated);
                                currentRow.find('.fromDate-label').text(room.fromDate);
                                currentRow.find('.ToDate-label').text(room.toDate);
                            },
                            error: function (error) {
                                            debugger;
                                            console.log(error);
                            }
                         });
            });
        // });
        // Configure Webcam.js
        Webcam.set({
            width: 320,
            height: 240,
            image_format: 'jpeg',
            jpeg_quality: 90
        });

        // Attach webcam to the div when modal opens
        document.getElementById('webcamModal').addEventListener('shown.bs.modal', function () {
            Webcam.attach('#my_camera');
        });

        // Detach webcam when modal closes
        document.getElementById('webcamModal').addEventListener('hidden.bs.modal', function () {
            Webcam.reset();
        });

        // Capture snapshot
        function takeSnapshot() {
            Webcam.snap(function (data_uri) {
                // Display captured image
                document.getElementById('results').style.display = 'block';
                document.getElementById('btnUploadSpan').style.display = 'block';
                document.getElementById('results').innerHTML = '<img src="' + data_uri + '"/>';
            });
        } 

            function saveImage() {
            Webcam.snap(function (data_uri) {
                var Id = document.getElementById('DevoteeId').value;
                var Code = document.getElementById('DevoteeCode').value;
                
                // Send image data to server
                $.ajax({
                    type: "POST",
                    url: '/Devotee/SaveImage',
                    data: {data:data_uri,Id:Id,Code:Code},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error saving image.');
                    },
                    
                });
            });
        }
        
        function AddItem() {
                var table = document.getElementById('tableBody');
                var rows = table.getElementsByTagName('tr');
                 var rowOuterHtml = rows[0].outerHTML;
                 var newRow = table.insertRow();
                 newRow.classList.add("rowClass");
                 newRow.innerHTML = rowOuterHtml; 
        }

        function DeleteItem(btn) {
                   var table = document.getElementById('RegTable');
                 var row = btn.parentNode.parentNode.rowIndex;
                 table.deleteRow(row);
        }

        function GetRooms(btn) {
                   var startDate =  document.getElementById("reg-start-date").value;
                var endDate =  document.getElementById("reg-end-date").value;
                $.ajax({
                    type: "POST",
                    url: '/Devotee/GetFilteredRooms',
                    contentType:"application/json; charset=utf-8",
                    dataType:"json",
                    data: {StartDate:startDate,EndDate:endDate},
                    success: function (response) {
                     
                    },
                    error: function () {
                        alert('Error');
                    },
                });
        }


        function saveNewDetails(){
            debugger;
            var table = document.getElementById('RegTable');
                //var rows = table.getElementsByTagName('tr');
                 let reservationList=[];
                 let index=0;
                var startDate =  document.getElementById("reg-start-date").value;
                var endDate =  document.getElementById("reg-end-date").value;
                var noOfDevotees =  document.getElementById("NoOfPeople").value;
                let sumNewAllot=0;
                let totalAllocated = 0;
               for (let i = 2; i < table.rows.length; i++) {
                var row = table.rows[i];
                // Check if the row contains the specified class name
                if (row.classList.contains("rowClass")) {
                  
                   var selectedElement =row.querySelector('.dropdown');
                   var roomSelected = selectedElement.value;
                   var roomSelectedText = selectedElement.options[selectedElement.selectedIndex].text;
                   var allot =  row.querySelector('.class-allot').value;
                   var remaining =  row.querySelector('.remaining-label').textContent.trim();
                    sumNewAllot += Number(allot);
                    if(roomSelected>0 && allot>0)
                        {
                               const validateRoomCapacity =@(ViewBag.ValidateRoomCapacity.ToString().ToLower());
                                if(validateRoomCapacity)
                                {
                                  if(Number(allot) > Number(remaining))
                                   {
                                        $.notify("Room: \""  + roomSelectedText + "\"  -  New Allotment: " + allot +" cannot be greater than Remaining: " + remaining, { globalPosition: "top centre", className:"error" });
                                        return false;
                                   }
                                }
                              if(reservationList.some(reservation => reservation.RoomId === roomSelected)) // true
                               {
                                    $.notify("Room: \""  + roomSelectedText + " has been selected more than once", { globalPosition: "top centre", className:"error" });
                                    return false;
                               }
                            reservationList[index++] = {
                                DevoteeId : document.getElementById('DevoteeId').value,
                                RoomId : roomSelected,
                                Allocated : allot,
                                FromDate: new Date(startDate),
                                ToDate:new Date(endDate)
                            };
                        }
                  }
                }
                if(reservationList.length>0)
                {

                                     var tableFoot = document.getElementById('tfoot');
                         var rowFooter = tableFoot.rows[0];
                        var col=rowFooter.cells[1];
                        totalAllocated =  col.textContent;
                        if(noOfDevotees - sumNewAllot -totalAllocated < 0)
                            {
                                $.notify("Allocated and new Allocation cannot be greater than No of Devotees: "  + noOfDevotees, { globalPosition: "top centre", className:"error" });
                                return false;
                            }
                    $.ajax({
                    type: "POST",
                    url: '/Devotee/AddReservation',
                    contentType:"application/json; charset=utf-8",
                    dataType:"json",
                    data:JSON.stringify(reservationList),
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                              window.location.reload();
                              return true;
                    },
                    error: function () {
                        alert('Error saving.');
                    },

                });
                }
                else
                {
                      $.notify("No Details to Update", { globalPosition: "top centre", className:"Failed" });
                    return false;
                }
                   
          }

          function CloseItem(id,devoteeId){
            $.ajax({
                    type: "POST",
                    url: '/Devotee/CloseReservation',
                    data:{Id: id,DevoteeId : devoteeId},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                      window.location.reload();
                      return true;
                    },
                    error: function () {
                        alert('Error saving.');
                    },

                });
          }
          function CloseReservations()
            {
                           var devoteeId = document.getElementById('DevoteeId').value;
                    $.ajax({
                            type: "POST",
                            url: '/Devotee/CloseReservations',
                            data:{DevoteeId : devoteeId},
                            success: function (response) {
                              $.notify("closed all Reservations for this Devotee Successfully", { globalPosition: "top centre", className:"Success" });
                              window.location.reload();
                              return true;
                            },
                            error: function () {
                                alert('Error saving.');
                            },

                        });
}
          function calculateTotal(){
                var table = document.getElementById('tableBody');
                var rows = table.getElementsByTagName('tr');
                
                let sum=0;

                for (let i = 1; i < table.rows.length; i++) {
                     var row = table.rows[i];
                    if (!row.classList.contains("rowClass")) {
                        if(row.cells[10].textContent.trim() != 'Closed')
                        {
                            sum += Number(row.cells[8].textContent);
                        }
                    }
                }
                                 var tableFoot = document.getElementById('tfoot');
