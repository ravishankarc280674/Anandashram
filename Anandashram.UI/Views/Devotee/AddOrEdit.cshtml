@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('.dropdown').change(function () {
            //     var rooms =
                    var id = $(this).val(); // Get selected value
                    var currentRow = $(this).closest('tr');
                              $.ajax({
                                    type: 'POST',
                                    url: '/Devotee/GetFilteredRoom',
                                    data: { Id: id }, // Parameters sent to the controller
                            success: function (Data) {
                                var room = Data.data;
                                console.log(room);
                                currentRow.find('.building-label').text(room.buildingName);
                                currentRow.find('.block-label').text(room.blockName);
                                currentRow.find('.floor-label').text(room.floorName);
                                currentRow.find('.maxCapacity-label').text(room.capacity);
                                currentRow.find('.remaining-label').text(room.remainingCapacity);
                                currentRow.find('.alreadyAllocate-label').text(room.allocated);
                                currentRow.find('.fromDate-label').text(room.fromDate);
                                currentRow.find('.ToDate-label').text(room.toDate);
                            },
                            error: function (error) {
                                alert(error);
                                console.log(error);
                            }
                         });
            });
        });
        // Configure Webcam.js
        Webcam.set({
            width: 320,
            height: 240,
            image_format: 'jpeg',
            jpeg_quality: 90
        });

        // Attach webcam to the div when modal opens
        document.getElementById('webcamModal').addEventListener('shown.bs.modal', function () {
            Webcam.attach('#my_camera');
        });

        // Detach webcam when modal closes
        document.getElementById('webcamModal').addEventListener('hidden.bs.modal', function () {
            Webcam.reset();
        });

        // Capture snapshot
        function takeSnapshot() {
            Webcam.snap(function (data_uri) {
                // Display captured image
                document.getElementById('results').style.display = 'block';
                document.getElementById('btnUploadSpan').style.display = 'block';
                document.getElementById('results').innerHTML = '<img src="' + data_uri + '"/>';
            });
        } 

            function saveImage() {
            Webcam.snap(function (data_uri) {
                var Id = document.getElementById('DevoteeId').value;
                var Code = document.getElementById('DevoteeCode').value;
                
                // Send image data to server
                $.ajax({
                    type: "POST",
                    url: '/Devotee/SaveImage',
                    data: {data:data_uri,Id:Id,Code:Code},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error saving image.');
                    },
                    
                });
            });
        }
        
        function AddItem() {

                var table;
                table = document.getElementById('RegTable');
                var rows = table.getElementsByTagName('tr');
                var rowOuterHtml = rows[rows.length - 1].outerHTML;

                var lastrowIdx = rows.length - 2;

                var nextrowIdx = eval(lastrowIdx) + 1;

                rowOuterHtml = rowOuterHtml.replaceAll('_' + lastrowIdx + '_', '_' + nextrowIdx + '_');
                rowOuterHtml = rowOuterHtml.replaceAll('[' + lastrowIdx + ']', '[' + nextrowIdx + ']');
                rowOuterHtml = rowOuterHtml.replaceAll('-' + lastrowIdx, '-' + nextrowIdx);

                var newRow = table.insertRow();
                newRow.innerHTML = rowOuterHtml;

                var x = document.getElementsByTagName("INPUT");

                for (var cnt = 0; cnt < x.length; cnt++) {
                    if (x[cnt].type == "text" && x[cnt].id.indexOf('_' + nextrowIdx + '_') > 0) {
                        if (x[cnt].id.indexOf('Unit') == 0)
                            x[cnt].value = '';
                    }
                    else if (x[cnt].type == "number" && x[cnt].id.indexOf('_' + nextrowIdx + '_') > 0)
                        x[cnt].value = 0;
                    else
                        x[cnt].value = '';

                }
            }

                 function rebindvalidators() {
                    var $form = $("#AddOrEditReservationForm");
                    $form.unbind();
                    $form.data("validator", null);
                    $.validator.unobtrusive.parse($form);
                    $form.validate($form.data("unobtrusiveValidation").options);
                }
                function DeleteItem(btn) {

               var table = document.getElementById('RegTable');
               var rows = table.getElementsByTagName('tr');

                    // var btnIdx = btn.id.replaceAll('btnremove-', '');
                    // var idOfQuantity = btnIdx + "__Quantity";
                    // var txtQuantity = document.querySelector("[id$='" + idOfQuantity + "']");

                    // txtQuantity.value = 0;


                    // var idOfIsDeleted = btnIdx + "__IsDeleted";
                    // var txtIsDeleted = document.querySelector("[id$='" + idOfIsDeleted + "']");
                   // txtIsDeleted.value="true";




                    $(btn).closest('tr').hide();

                    // CalcTotals();

        }
    </script>
}