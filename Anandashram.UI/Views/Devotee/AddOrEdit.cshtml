
@model Anandashram.Models.Devotee

@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = currentModel + " - Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";

    AddFile addFile = ViewBag.AddFile;
    var uploadedFiles = ViewBag.UploadedFiles;
    if (Model.Id != 0)
    {
        addFile.DevoteeId = Model.Id;
        addFile.DevoteeCode = Model.Code;
        ViewBag.AddFile = addFile;
    }
    int pg = 1;
    var roomsList = ViewBag.RoomsList;
    string searchText = ViewBag.SearchText;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
}
@if(Model.Id == 0)
{
    <h4>@currentModel - Add </h4>
}
else
{
    <h4>@currentModel - Edit </h4>
}

<hr />

<div class="card">
    <div class="col-md-12">
        <form asp-action="AddOrEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />
            <input type="hidden" asp-for="ModifiedBy" />
            <input type="hidden" asp-for="ModifiedDate" />
            <input type="hidden" asp-for="Closed" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (Model.Id != 0)
            {
              <div class="col-md-12 d-flex">
              
                <div class="col-md-5">

                        <table style="border:none;">
                <tr>
                                <td class="form-group col-2 " rowspan="2"><img src="@Url.Action("GetImage", "Devotee", new { fileName = Model.Code })" width="100" height="100" class="img-thumbnail rounded" target="_blank" /></td>
                                <td style="border:none" class="text-start"><div><label class="fs-4 fw-bold" style="color: purple">@Html.DisplayFor(model => model.Name)</label></div></td>
                                
                    </tr>
                            <tr style="border:none;">
                                <td style="border:none" class="text-start">
                      <div>
                                <label class="fs-4 fw-bold" style="color: purple">@Html.DisplayFor(model => model.Code)</label>
                                <a data-bs-toggle="modal" data-bs-target="#webcamModal" data-item-Id = "@Model.Id" data-item-Code = "@Model.Code">
                                    <span class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-display" aria-hidden="true" title="Show Camera"></i>
                                </span>
                                </a>
                            </div>
                        </td>
                    </tr>
                    </table>
                   
                </div>
                    <div class="form-group col-2">
                    </div>
                    <div class="form-group col-5 text-end">
                    
                    <table>
                            <tr>
                        <td colspan="3">
                                        <div class="col text-end fw-bold">
                                Document List
                                <a data-bs-toggle="modal" data-bs-target="#uploadModal" class=" align-self-end">
                                    <span class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-add" aria-hidden="true" title="Add Documents"></i>
                                    </span>
                                </a>
                            </div>
                        </td>
                            </tr>
                            @if(uploadedFiles!=null)
                            {
                            @foreach(var fileUpload in uploadedFiles)
                                {
                                   <tr>
                                        <td class="col-sm-10">
                                            @fileUpload.FileName
                                        </td>
                                        <td><span class="btn btn-sm btn-outline-secondary">@Html.ActionLink("", "GetDocument", new { fileName = @fileUpload.FileName, filePath = @fileUpload.FilePath }, new { @class = "fa-solid fa-download" })</span></td>
                                       <td>
                                            <a asp-action="DeleteDocument" asp-route-filePath="@fileUpload.FilePath" onsubmit="return jQueryAjaxDelete(this);" asp-route-Id="@fileUpload.DevoteeId">
                                                <span class="btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-cut" aria-hidden="true" title="Remove"></i>
                                                </span>
                                            </a>
                                       </td>
                                   </tr>
                               }
                            }
                            else
                            {
                                <tr>
                                    <td>No Documents Uploaded</td>
                                </tr>
                            }
                        </table>
                </div>
            </div>
            <br />
            }
            <dl class="row">
                <dt class="col-md-2">
                    <label asp-for="Name" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                </dd>
                <dt class="col-md-2">
                    <label asp-for="DevoteeCategoryId" class="control-label"></label>
                </dt>
                <dd class="form-group col-md-4">
                        <select asp-for="DevoteeCategoryId" class="form-control" asp-items="ViewBag.DevoteeCategoryId"></select>
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-md-2">
                    <label asp-for="StartDate" class="control-label"></label>
                </dt>
                <dd class="col-md-4 form-group">
                    <input  asp-for="StartDate" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </dd>
              
                <dt class="col-md-2">
                    <label asp-for="EndDate" class="control-label"></label>
                </dt>
                <dd class="col-md-4 form-group">
                    <input  asp-for="EndDate" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </dd>
            </dl>
            <dl class="row">
                <dt class="col-md-2">
                    <label asp-for="AddressLine1" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                        <input asp-for="AddressLine1" class="form-control" />
                        <span asp-validation-for="AddressLine1" class="text-danger"></span>
                    </dd>
                </dl>

                <dl class="row">
                <dt class="col-md-2">
                    
                </dt>
                <dd class="col-md-4">
                        <input asp-for="AddressLine2" class="form-control" />
                        <span asp-validation-for="AddressLine2" class="text-danger"></span>
                    </dd>
                </dl>
            <dl class="row">
                <dt class="col-md-2">
                    <label asp-for="State" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </dd>
                <dt class="col-md-2">
                        <label asp-for="Country" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                    <input asp-for="Country" class="form-control" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </dd>
            </dl>
              <dl class="row">
                <dt class="col-md-2">
                        <label asp-for="PinCode" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                    <input asp-for="PinCode" class="form-control" />
                    <span asp-validation-for="PinCode" class="text-danger"></span>
                </dd>
            </dl>
              <dl class="row">
                <dt class="col-md-2">
                      <label asp-for="Mobile" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                    <input asp-for="Mobile" class="form-control" />
                    <span asp-validation-for="Mobile" class="text-danger"></span>
                </dd>
                <dt class="col-md-2">
                        <label asp-for="Email" class="control-label"></label>
                </dt>
                <dd class="col-md-4">
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </dd>
            </dl>
            </form>
            <br />
            <div class="row">
                <div class="form-group btn-group">
                    @if (Model.Closed == false)
                    {
                        <input type="submit" name="actionButton" value="Submit" class="btn btn-primary" />
                    }
                    &nbsp;
                    @if(Model.Id !=0 && Model.Closed==false)
                    {
                        <input type="submit" name="actionButton" value="Closed" class="btn btn-danger" />
                    }
                    @if (Model.Id != 0 && String.IsNullOrEmpty(Model.ReopenedCode) && Model.Closed == true)
                    {
                        <input type="submit" name="actionButton" value="Reopen" class="btn btn-info" />
                    }
                    &nbsp;<a class="btn btn-secondary" asp-action="index"
                       asp-route-pg="@TempData.Peek("CurrentPage")" asp-route-SearchText ="@ViewBag.SearchText">Back</a>
                </div>
            </div>

            <br />

            @* Add Reservation Details here *@

            <button class="btn btn-info" type="button" data-bs-toggle="collapse" data-bs-target="#manageReservationDiv" aria-expanded="false" aria-controls="toggleDiv">
                Manage Reservation(s)
            </button>
            <br />
           
            <div class="collapse mt-12 border-2" id="manageReservationDiv">
                <div class="card card-body">
            <form asp-action="AddOrEditReservation" asp-route-id="@Model.Id" asp-route-pg="@pg" asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">

                    <div class="col-12 ml-5">
                        <dl class="row">
                            <dt class="col-md-2">
                                <label asp-for="StartDate" class="control-label"></label>
                            </dt>
                            <dd class="col-md-4 form-group">
                                <input asp-for="StartDate" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </dd>

                            <dt class="col-md-2">
                                <label asp-for="EndDate" class="control-label"></label>
                            </dt>
                            <dd class="col-md-4 form-group">
                                <input asp-for="EndDate" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </dd>
                        </dl>
                        <table id="RegTable" class="table table-borderless table-sm mb-0 pb-0">
                            <thead>
                                <tr>
                                    <th>
                                        Room
                                    </th>
                                    <th>
                                        Floor
                                    </th>
                                    <th>
                                        Block
                                    </th>
                                    <th>
                                        Building
                                    </th>
                                    <th>
                                        Max Capacity
                                    </th>
                                    <th>
                                        Remaining
                                    </th>
                                    <th>
                                       Already Allocate
                                    </th>
                                    <th>
                                        New Allocation
                                    </th>
                                    <th style="width:60px;">
                                        <button id='btnAddDetailRow' type="button" class="btn btn-sm btn-secondary visible" onclick="AddItem(this)">
                                            Add
                                        </button>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                 @for (int i = 0; i < Model.ReservationCharts.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <select asp-for="@Model.ReservationCharts[i].Id" class="form-control dropdown"
                                                    asp-items="ViewBag.RoomsList"></select>
                                        </td>
                                         <td>
                                            <label class="building-label" />
                                        </td>
                                        <td>
                                            <label class="block-label" />
                                        </td>
                                        <td>
                                            <label class="floor-label"/>
                                        </td>
                                        @* <td>
                                            <input asp-for="@Model.PoDetails[i].UnitName" class="form-control" readonly />
                                        </td>
                                        <td style="width:60px;">
                                            <button id='btnremove-@i' type="button" class="btn btn-sm btn-danger visible" onclick="DeleteItem(this)">
                                                Delete
                                            </button>
                                        </td> *@
                                    </tr>
                                } 
                            </tbody>

                        </table>
                    </div>
               
        </form>
            </div>
        </div>
    </div>

               @* modal 1 starts here - to load the web cam *@
    <div id="webcamModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-dialog custom-modal" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Upload Profile Picture</h5>
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                    <partial name="_UploadProfilePic" model="@Model" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    

        @* modal 2 starts here - to upload documents either by browing or scanning*@
    <div id="uploadModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Document / Picture</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <partial name="_UploadDocument" model="ViewBag.AddFile" />
                </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
        $('.dropdown').change(function () {
        //     var rooms =
                var id = $(this).val(); // Get selected value
                          $.ajax({
                                type: 'POST',
                                url: '/Devotee/GetFilteredRoom',
                                data: { Id: id }, // Parameters sent to the controller
                        success: function (Data) {
                            var room = Data.data;
                            alert("building:" +  room.buildingName);
                            $(this).closest('tr').find('.block-label').text = room.blockName;
                            $(this).closest('tr').find('.building-label').text = room.buildingName;
                            $(this).closest('tr').find('.floor-label').text = room.floorName;
                        },
                        error: function (error) {
                            alert(error);
                            console.log(error);
                        }
                     });
        });
        });
        // Configure Webcam.js
        Webcam.set({
            width: 320,
            height: 240,
            image_format: 'jpeg',
            jpeg_quality: 90
        });

        // Attach webcam to the div when modal opens
        document.getElementById('webcamModal').addEventListener('shown.bs.modal', function () {
            Webcam.attach('#my_camera');
        });

        // Detach webcam when modal closes
        document.getElementById('webcamModal').addEventListener('hidden.bs.modal', function () {
            Webcam.reset();
        });

        // Capture snapshot
        function takeSnapshot() {
            Webcam.snap(function (data_uri) {
                // Display captured image
                document.getElementById('results').style.display = 'block';
                document.getElementById('btnUploadSpan').style.display = 'block';
                document.getElementById('results').innerHTML = '<img src="' + data_uri + '"/>';
            });
        }

            function saveImage() {
            Webcam.snap(function (data_uri) {
                var Id = document.getElementById('DevoteeId').value;
                var Code = document.getElementById('DevoteeCode').value;
                
                // Send image data to server
                $.ajax({
                    type: "POST",
                    url: '/Devotee/SaveImage',
                    data: {data:data_uri,Id:Id,Code:Code},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error saving image.');
                    },
                    
                });
            });
        }
        
        function AddItem() {

                var table;
                table = document.getElementById('RegTable');
                var rows = table.getElementsByTagName('tr');
                var rowOuterHtml = rows[rows.length - 1].outerHTML;

                var lastrowIdx = rows.length - 2;

                var nextrowIdx = eval(lastrowIdx) + 1;

                rowOuterHtml = rowOuterHtml.replaceAll('_' + lastrowIdx + '_', '_' + nextrowIdx + '_');
                rowOuterHtml = rowOuterHtml.replaceAll('[' + lastrowIdx + ']', '[' + nextrowIdx + ']');
                rowOuterHtml = rowOuterHtml.replaceAll('-' + lastrowIdx, '-' + nextrowIdx);

                var newRow = table.insertRow();
                newRow.innerHTML = rowOuterHtml;

                var x = document.getElementsByTagName("INPUT");

                for (var cnt = 0; cnt < x.length; cnt++) {
                    if (x[cnt].type == "text" && x[cnt].id.indexOf('_' + nextrowIdx + '_') > 0) {
                        if (x[cnt].id.indexOf('Unit') == 0)
                            x[cnt].value = '';
                    }
                    else if (x[cnt].type == "number" && x[cnt].id.indexOf('_' + nextrowIdx + '_') > 0)
                        x[cnt].value = 0;
                }

               // rebindvalidators();
            }
    </script>
}