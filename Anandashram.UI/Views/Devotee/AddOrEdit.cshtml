@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // $(document).ready(function () {
           $(document).on('change', '.dropdown',function () {
            //     var rooms =
                    var id = $(this).val(); // Get selected value
                    var currentRow = $(this).closest('tr');
                              $.ajax({
                                    type: 'POST',
                                    url: '/Devotee/GetSelectedRoom',
                                    data: { Id: id }, // Parameters sent to the controller
                            success: function (Data) {
                                var room = Data.data;
                                currentRow.find('.building-label').text(room.buildingName);
                                currentRow.find('.block-label').text(room.blockName);
                                currentRow.find('.floor-label').text(room.floorName);
                                currentRow.find('.maxCapacity-label').text(room.capacity);
                                currentRow.find('.remaining-label').text(room.remaining);
                                currentRow.find('.alreadyAllocate-label').text(room.allocated);
                                currentRow.find('.fromDate-label').text(room.fromDate);
                                currentRow.find('.ToDate-label').text(room.toDate);
                            },
                            error: function (error) {
                                alert(error);
                                console.log(error);
                            }
                         });
            });
        // });
        // Configure Webcam.js
        Webcam.set({
            width: 320,
            height: 240,
            image_format: 'jpeg',
            jpeg_quality: 90
        });

        // Attach webcam to the div when modal opens
        document.getElementById('webcamModal').addEventListener('shown.bs.modal', function () {
            Webcam.attach('#my_camera');
        });

        // Detach webcam when modal closes
        document.getElementById('webcamModal').addEventListener('hidden.bs.modal', function () {
            Webcam.reset();
        });

        // Capture snapshot
        function takeSnapshot() {
            Webcam.snap(function (data_uri) {
                // Display captured image
                document.getElementById('results').style.display = 'block';
                document.getElementById('btnUploadSpan').style.display = 'block';
                document.getElementById('results').innerHTML = '<img src="' + data_uri + '"/>';
            });
        } 

            function saveImage() {
            Webcam.snap(function (data_uri) {
                var Id = document.getElementById('DevoteeId').value;
                var Code = document.getElementById('DevoteeCode').value;
                
                // Send image data to server
                $.ajax({
                    type: "POST",
                    url: '/Devotee/SaveImage',
                    data: {data:data_uri,Id:Id,Code:Code},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                        window.location.reload();
                    },
                    error: function () {
                        alert('Error saving image.');
                    },
                    
                });
            });
        }
        
        function AddItem() {
                var table = document.getElementById('tableBody');
                debugger;
                var rows = table.getElementsByTagName('tr');
                 var rowOuterHtml = rows[0].outerHTML;
                 var newRow = table.insertRow();
                 newRow.classList.add("rowClass");
                 newRow.innerHTML = rowOuterHtml; 
        }

        function DeleteItem(btn) {
                   var table = document.getElementById('RegTable');
                 var row = btn.parentNode.parentNode.rowIndex;
                 table.deleteRow(row);
        }

        function GetRooms(btn) {
            debugger;
                   var startDate =  document.getElementById("reg-start-date").value;
                var endDate =  document.getElementById("reg-end-date").value;
                $.ajax({
                    type: "POST",
                    url: '/Devotee/GetFilteredRooms',
                    contentType:"application/json; charset=utf-8",
                    dataType:"json",
                    data: {StartDate:startDate,EndDate:endDate},
                    success: function (response) {
                     
                    },
                    error: function () {
                        alert('Error');
                    },

                });
        }


        function saveNewDetails(data){
            var table = document.getElementById('RegTable');
                var rows = table.getElementsByTagName('tr');
                 let reservationList=[];
                 let index=0;
                var startDate =  document.getElementById("reg-start-date").value;
                var endDate =  document.getElementById("reg-end-date").value;
                
               for (let i = 2; i < table.rows.length; i++) {
                var row = table.rows[i];
                // Check if the row contains the specified class name
                if (row.classList.contains("rowClass")) {
                   var roomSelected = row.querySelector('.dropdown').value;
                   var allot =  row.querySelector('.class-allot').value;
                   
                  if(roomSelected>0 && allot>0)
                {
                    reservationList[index++] = {
                        DevoteeId : document.getElementById('DevoteeId').value,
                        RoomId : roomSelected,
                        Allocated : allot,
                        FromDate: new Date(startDate),
                        ToDate:new Date(endDate)
                    };
                    
                }
                
                  }
                }

                if(reservationList.length>0)
                {
                    $.ajax({
                    type: "POST",
                    url: '/Devotee/AddReservation',
                    contentType:"application/json; charset=utf-8",
                    dataType:"json",
                    data: JSON.stringify(reservationList),
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                      return true;
                    },
                    error: function () {
                        alert('Error saving.');
                    },

                });
                }
                   
          }

          function CloseItem(id,devoteeId){
              debugger;
            $.ajax({
                    type: "POST",
                    url: '/Devotee/CloseReservation',
                    contentType:"application/json; charset=utf-8",
                    dataType:"json",
                    data:{id: id,devoteeId : devoteeId},
                    success: function (response) {
                      $.notify("Submitted Successfully", { globalPosition: "top centre", className:"Success" });
                      return true;
                    },
                    error: function () {
                        alert('Error saving.');
                    },

                });
          }
    </script>
}