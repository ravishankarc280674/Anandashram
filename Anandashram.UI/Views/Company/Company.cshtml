@model Anandashram.Models.Company

@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = currentModel;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <i class="bi bi-building"></i> @ViewData["Title"] Details
            </h4>
        </div>

        <div class="card-body bg-light">
            <form asp-action="SaveCompany" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold text-success"></label>
                        <input asp-for="Name" class="form-control border-success" placeholder="Enter company name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Established" class="form-label fw-semibold text-success"></label>
                        <input type="number" asp-for="Established" class="form-control border-success" step="1" min="1900" max="3000" placeholder="YYYY" />
                        <span asp-validation-for="Established" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AddressLine1" class="form-label fw-semibold text-success"></label>
                    <input asp-for="AddressLine1" class="form-control border-success" placeholder="Address Line 1" />
                    <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="AddressLine2" class="form-control border-success" placeholder="Address Line 2 (Optional)" />
                    <span asp-validation-for="AddressLine2" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label fw-semibold text-success"></label>
                        <input asp-for="State" class="form-control border-success" placeholder="Enter state" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Country" class="form-label fw-semibold text-success"></label>
                        <input asp-for="Country" class="form-control border-success" placeholder="Enter country" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="PinCode" class="form-label fw-semibold text-success"></label>
                        <input asp-for="PinCode" class="form-control border-success" placeholder="Enter pin code" />
                        <span asp-validation-for="PinCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Mobile" class="form-label fw-semibold text-success"></label>
                        <input asp-for="Mobile" class="form-control border-success" placeholder="Enter mobile number" />
                        <span asp-validation-for="Mobile" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold text-success"></label>
                        <input asp-for="Email" class="form-control border-success" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label fw-semibold text-success"></label>
                        <input asp-for="Website" class="form-control border-success" placeholder="Enter website URL" />
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-success px-4 me-2">
                        <i class="bi bi-check-circle"></i> Submit
                    </button>
                    <a class="btn btn-outline-success px-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
