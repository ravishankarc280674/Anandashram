@{
    Layout = "_Layout";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-success fw-bold">@ViewBag.Title</h4>

        <a asp-controller="@ViewBag.BackController" asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-arrow-left me-1"></i> Back
        </a>
    </div>

    <div class="border border-3 border-success rounded shadow-sm p-2" style="height: 85vh;">
        <iframe src="@ViewBag.PdfSource"
                style="width:100%; height:100%; border:none;"></iframe>
    </div>
</div>
