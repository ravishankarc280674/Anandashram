
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-bed me-2"></i> Room check-Out Report
            </h4>
        </div>

        <div class="card-body">
            <form asp-action="CheckOutViewer" method="post" class="row g-4 align-items-end mb-4">
                <!-- Date Picker -->
                <div class="col-md-4">
                    <label for="dateValue" class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar-alt text-success me-2"></i> Choose Date:
                    </label>
                    <input type="date"
                           id="dateValue"
                           name="dateValue"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control border-success shadow-sm" />
                </div>
                <!-- Report Status Type (All / Open / Closed) -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary d-block">
                        <i class="fas fa-table-list me-2 text-success"></i> Status:
                    </label>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportAll"
                               name="dataType" value="All" checked />
                        <label class="form-check-label fw-bold" for="reportAll">
                            <i class="fas fa-layer-group me-1 text-success"></i> All
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportOpen"
                               name="dataType" value="Open" />
                        <label class="form-check-label fw-bold" for="reportOpen">
                            <i class="fas fa-check-circle me-1 text-danger"></i> Open
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportClosed"
                               name="dataType" value="Closed" />
                        <label class="form-check-label fw-bold" for="reportClosed">
                            <i class="fas fa-door-closed me-1 text-primary"></i> Closed
                        </label>
                    </div>
                </div>

                <!-- Report Type -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary d-block">
                        <i class="fas fa-file-alt text-success me-2"></i> Choose Report Type:
                    </label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportScreen"
                        name="typeofreport" value="screen" checked />
                        <label class="form-check-label fw-bold" for="reportScreen">
                            <i class="fas fa-desktop text-success me-1"></i> Screen
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportPdf" name="typeofreport" value="pdf" />
                        <label class="form-check-label fw-bold" for="reportPdf">
                            <i class="fas fa-file-pdf text-danger me-1"></i> PDF
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportExcel" name="typeofreport" value="excel" />
                        <label class="form-check-label fw-bold" for="reportExcel">
                            <i class="fas fa-file-excel text-success me-1"></i> Excel
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="col-md-2 text-center">
                    <button type="button" id="btnGenerate" class="btn btn-success fw-bold px-4 shadow-sm">
                        <i class="fas fa-play-circle me-2"></i> Generate
                    </button>
                </div>
            </form>
           
            <!-- Report Display -->
            <div class="report-container border border-3 border-success rounded p-3">
                <div id="pdfViewer" style="height: 750px; display:none;">
                    <iframe id="frmPdf" width="100%" height="100%"></iframe>
                </div>
            </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        <script>
                   $("#btnGenerate").click(function () {

            var dateValue = $("#dateValue").val();
                var reportType = $("input[name='typeofreport']:checked").val();
                        var dataType = $("input[name='dataType']:checked").val();

            if (!dateValue) return;

            var formData = new FormData();
            formData.append("dateValue", dateValue);
                formData.append("typeofreport", reportType);
                formData.append("dataType", dataType);
                formData.append("reportname", "Check-out Report");

            $.ajax({
                url: "/Report/CheckOutViewer",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (data, status, xhr) {

                    var blob = new Blob([data],
                        { type: xhr.getResponseHeader("Content-Type") });

                    if (reportType === "screen") {
                        var url = URL.createObjectURL(blob);
                        $("#frmPdf").attr("src", url);
                        $("#pdfViewer").show();
                    }
                    else {
                        // Force file download
                        var downloadUrl = URL.createObjectURL(blob);
                        var a = document.createElement("a");
                        a.href = downloadUrl;
                        a.download = xhr.getResponseHeader("FileName") || "Report";
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        URL.revokeObjectURL(downloadUrl);
                    }
                },
                error: function () {
                    alert("Failed to generate report. Try again.");
                }
            });
        });

    </script>
}

<style>
    .card-header {
        background: linear-gradient(90deg, #198754 0%, #157347 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: 0.5px;
    }

    .report-container {
        background-color: #ffffff;
        min-height: 500px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease-in-out;
    }

        .report-container:hover {
            box-shadow: 0 0 20px rgba(25, 135, 84, 0.3);
        }

    .btn-success {
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-success:hover {
            background-color: #157347;
            transform: scale(1.03);
        }

    label {
        font-size: 0.95rem;
    }
</style>
