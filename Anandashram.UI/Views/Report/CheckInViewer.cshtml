@model FastReport.Web.WebReport

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center rounded-top">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-bed me-2"></i> Room Reports
            </h4>
        </div>

        <div class="card-body">
            <form asp-action="CheckInViewer" method="post" class="row g-4 align-items-end mb-4">
                <!-- Date Picker -->
                <div class="col-md-4">
                    <label for="dateValue" class="form-label fw-semibold text-secondary">
                        <i class="fas fa-calendar-alt text-success me-2"></i> Choose Date:
                    </label>
                    <input type="date"
                           id="dateValue"
                           name="dateValue"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="form-control border-success shadow-sm" />
                </div>
                <!-- Report View Type (List / Detail) -->
                <div class="col-md-4" style="display:none">
                    <label class="form-label fw-semibold text-secondary d-block">
                        <i class="fas fa-table-list me-2 text-success"></i> Report Format:
                    </label>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportList"
                               name="reportformat" value="list" checked />
                        <label class="form-check-label fw-bold" for="reportList">
                            <i class="fas fa-bars me-1 text-success"></i> List
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportDetail"
                               name="reportformat" value="detail" />
                        <label class="form-check-label fw-bold" for="reportDetail">
                            <i class="fas fa-list-ul me-1 text-primary"></i> Detail
                        </label>
                    </div>
                </div>

                <!-- Report Type -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary d-block">
                        <i class="fas fa-file-alt text-success me-2"></i> Choose Report Type:
                    </label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportScreen" name="typeofreport" value="screen" checked />
                        <label class="form-check-label fw-bold" for="reportScreen">
                            <i class="fas fa-desktop text-success me-1"></i> Screen
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="reportPdf" name="typeofreport" value="pdf" />
                        <label class="form-check-label fw-bold" for="reportPdf">
                            <i class="fas fa-file-pdf text-danger me-1"></i> PDF
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="col-md-2 text-center">
                    <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm">
                        <i class="fas fa-play-circle me-2"></i> Generate
                    </button>
                </div>
            </form>

            <!-- Report Display -->
            <div class="report-container border border-3 border-success rounded p-3">
                @if (Model != null)
                {
                    @await Model.Render()
                }
                else
                {
                    <div class="alert alert-warning text-center fw-semibold" role="alert">
                        <i class="fas fa-info-circle me-2"></i> No report to display. Please generate a report.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card-header {
        background: linear-gradient(90deg, #198754 0%, #157347 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        letter-spacing: 0.5px;
    }

    .report-container {
        background-color: #ffffff;
        min-height: 500px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease-in-out;
    }

        .report-container:hover {
            box-shadow: 0 0 20px rgba(25, 135, 84, 0.3);
        }

    .btn-success {
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-success:hover {
            background-color: #157347;
            transform: scale(1.03);
        }

    label {
        font-size: 0.95rem;
    }
</style>
