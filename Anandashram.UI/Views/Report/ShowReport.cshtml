@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 fw-bold">
                <i class="fas fa-file-alt me-2"></i> Reports
            </h4>
            <button class="btn btn-light btn-sm fw-bold" onclick="window.print()">
                <i class="fas fa-print me-1"></i> Print
            </button>
        </div>

        <div class="card-body" style="border: 8px solid #198754; border-radius: 12px;">
            @if (Model != null)
            {
                <div class="report-container">
                    @RenderBody()
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center fw-semibold" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    No report data available to display.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Optional styling or behavior enhancements
        document.addEventListener("DOMContentLoaded", function () {
            document.body.style.backgroundColor = "#f8f9fa"; // light gray background
        });
    </script>
}

<style>
    .report-container {
        background-color: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        min-height: 500px;
    }

    .card-header h4 {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
</style>
