@model IEnumerable<Building>
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = "Building - List";
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;

    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
}
<h3><i class="fas fa-comment-dollar text-success"></i> Building - List</h3>
<div class="container-fluid btn-group">
    <div class="col-10">
        
    </div>
    <div class="col-2 justify-content-end">
        <p>
             <a onclick="showInPopup('@Url.Action("AddOrEdit","Building",null,Context.Request.Scheme)','Building - New')" class="btn btn-success"><i class="fas fa-random"></i>Create New</a> 
        </p>
    </div>
</div>
<br />


<div class="row">
    <div class="col-12">
        <partial name="_pager" model="@pager" />
    </div>
</div>
 
<!--table comes here-->
<div id="view-all">
    @await Html.PartialAsync("_ViewAll", Model)
</div>
<div class="row">
    <div class="col-12">
        <partial name="_BottomBar" model="@pager" />
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
