@model HomeDTO

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-3 mb-4 text-center dashboard-header">

    <!-- Heading -->
    <div class="text-center mb-1">
        <h1 class="fw-bold text-success">Welcome to Anandashram</h1>
        <p class="text-muted fs-5">Devotee Management Dashboard</p>
    </div>
</div>

    <!-- ====== STATISTICS SECTION ====== -->
    <div class="row g-4 mb-1 justify-content-center">
        <!-- Total Devotees -->
        <div class="col-md-3">
        <div class="card shadow border-0 bg-primary text-white rounded-4 stats-card">
            <div class="card-body text-center">
                <i class="fas fa-users"></i>
                <h6 class="fw-semibold">Total Devotees</h6>
                <h2 class="fw-bold">@Model.TotalDevoteesCount</h2>
            </div>
        </div>
    </div>
        

        <!-- Active Devotees -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-success text-white rounded-4 stats-card">
                <div class="card-body text-center">
                    <i class="fas fa-user-check"></i>
                    <h6 class="fw-semibold">Active Devotees</h6>
                    <h2 class="fw-bold">@Model.TotalActiveDevotees</h2>
                </div>
            </div>
        </div>
         
        <!-- Total Room Capacity -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-warning text-white rounded-4 stats-card">
                <div class="card-body text-center">
                    <i class="fas fa-hotel"></i>
                    <h6 class="fw-semibold">Total Capacity</h6>
                    <h2 class="fw-bold">@Model.TotalRoomCapacity</h2>
                </div>
            </div>
        </div>

        <!-- Available Room Capacity -->
        <div class="col-md-3">
            <div class="card shadow border-0 bg-info text-white rounded-4 stats-card">
                <div class="card-body text-center">
                    <i class="fas fa-door-open"></i>
                    <h6 class="fw-semibold">Available Capacity</h6>
                    <h2 class="fw-bold">@Model.TotalRoomCapacityAvailable</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== Chart =========== -->
    <div class="card shadow-sm border-0">
        <div class="card-header fw-bold bg-light">
            This Month — Check-In / Check-Out Trend
        </div>
        <div class="card-body position-relative" style="height: 220px;">
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <div id="weeklySummary" class="mt-3 fw-bold text-center"></div>


    <!-- ========== EXISTING MENU CARDS ========== -->
    <div class="row g-4 justify-content-center">

        <!-- Company Card -->
        <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card shadow border-0 text-center rounded-4 hover-card bg-primary text-white stats-card">
                <div class="card-body">
                    <a asp-controller="Company" asp-action="Company" class="text-decoration-none text-white">
                        <i class="fas fa-building fa-3x mb-3"></i>
                        <h5 class="fw-semibold">Company</h5>
                    </a>
                </div>
            </div>
        </div>

        <!-- Devotees -->
        <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card shadow border-0 text-center rounded-4 hover-card bg-success text-white stats-card">
                <div class="card-body">
                    <a asp-controller="Devotee" asp-action="Index" class="text-decoration-none text-white">
                        <i class="fas fa-users fa-3x mb-3"></i>
                        <h5 class="fw-semibold">Devotees</h5>
                    </a>
                </div>
            </div>
        </div>

        <!-- Rooms -->
        <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card shadow border-0 text-center rounded-4 hover-card bg-warning text-dark stats-card">
                <div class="card-body">
                    <a asp-controller="Room" asp-action="Index" class="text-decoration-none text-dark">
                        <i class="fas fa-hotel fa-3x mb-3"></i>
                        <h5 class="fw-semibold">Rooms</h5>
                    </a>
                </div>
            </div>
        </div>

        <!-- Reservations -->
        <div class="col-lg-3 col-md-4 col-sm-6">
        <div class="card shadow border-0 text-center rounded-4 hover-card bg-info text-white stats-card">
                <div class="card-body">
                    <a asp-controller="Reservation" asp-action="Index" class="text-decoration-none text-white">
                        <i class="fas fa-calendar-check fa-3x mb-3"></i>
                        <h5 class="fw-semibold">Reservations</h5>
                    </a>
                </div>
            </div>
        </div>

    </div>

<style>
    /* Reduce spacing globally for dashboard */
    .dashboard-wrapper {
        padding-top: 10px;
    }

    /* Reduce space in heading */
    .dashboard-header h1 {
        font-size: 1.8rem;
        margin-bottom: 0.2rem;
    }
    .dashboard-title {
        margin-top: -10px; /* adjust between -5px to -20px as you prefer */
    }
    /* Reduce gap between heading and stats */
    .dashboard-header {
        margin-bottom: 0.4rem !important;
    }
    .stats-card .card-body i {
        margin-bottom: 0.25rem !important;
    }
    /* Compact statistics cards */
    .stats-card {
        padding: 0.45rem 0 !important;
    }
    .stats-card i {
        font-size: 1.30rem !important;
        margin-bottom: 0.2rem !important;
    }
    .stats-card h6 {
        margin-bottom: 0.2rem !important;
    }
    .stats-card h2 {
        font-size: 1.6rem !important;
        margin-bottom: 0 !important;
    }
    /* Reduce the chart height */
    #trendChart {
        height: 180px !important;
    }
</style>
@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDTO.Dates));
    const checkIns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDTO.DailyCheckIns));
    const checkOuts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDTO.DailyCheckOuts));

    const todayIndex = labels.length - 1;

    const ctx = document.getElementById('trendChart');

    const trendChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Check-Ins',
                    data: checkIns,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 6,
                    hoverRadius: 10,
                    borderColor: '#007bff',
                    pointBackgroundColor: (ctx) =>
                        ctx.dataIndex === todayIndex ? '#dc3545' : '#007bff'
                },
                {
                    label: 'Check-Outs',
                    data: checkOuts,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 6,
                    hoverRadius: 10,
                    borderColor: '#28a745',
                    pointBackgroundColor: (ctx) =>
                        ctx.dataIndex === todayIndex ? '#ffc107' : '#28a745'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { display: true },
                tooltip: { callbacks: { labelColor: () => ({ borderColor: 'white' }) } }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });

    // Weekly Summary
    document.getElementById("weeklySummary").innerHTML =
        `📊 Last 7 Days → 
         Check-Ins: <b>${checkIns.slice(-7).reduce((a, b) => a + b, 0)}</b> |
         Check-Outs: <b>${checkOuts.slice(-7).reduce((a, b) => a + b, 0)}</b>`;
</script>

}

