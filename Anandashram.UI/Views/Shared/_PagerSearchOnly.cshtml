@using Anandashram.UI.Tools.Core.Models
@model PageModel

<style>
    .page-link {
        color: black !important;
    }
     
 
</style>

<div class="dev-toolbar container-fluid d-flex justify-content-between align-items-center flex-wrap">

    <!-- LEFT SIDE -->
    <form asp-action="Index"
          asp-route-SearchText="@ViewBag.SearchText"
          asp-route-Closed="@ViewBag.Closed"
          class="d-flex align-items-center m-0 flex-nowrap dev-toolbar-form">

        <input class="form-control dev-search-input me-2"
               type="text"
               name="SearchText"
               value="@ViewBag.SearchText"
               placeholder="Search Key" />

        <button type="submit" class="btn dev-btn-search d-flex align-items-center px-3">
            <i class="fa fa-search"></i> Search
        </button>

    </form>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center flex-wrap justify-content-end gap-2">

        <!-- REPORT BUTTONS -->
        @if (Model != null)
        {
            if(Model.ControllerName=="Room")
            {
                <form asp-controller="Report"
                      asp-route-reportType="@ViewBag.ReportType"
                      asp-action="ShowReport"
                      method="post"
                      class="d-flex align-items-center m-0 flex-nowrap dev-toolbar-form">

                    <button type="submit" class="btn dev-btn-screen"
                            name="actionButton" value="Screen" title="View On Screen">
                        <i class="fa fa-print"></i>
                    </button>

                    <button type="submit" class="btn dev-btn-pdf"
                            name="actionButton" value="Pdf" title="Download PDF">
                        <i class="fa fa-file-pdf"></i>
                    </button>

                    <button type="submit" class="btn dev-btn-excel"
                            name="actionButton" value="Excel" title="Download Excel">
                        <i class="fa fa-file-excel"></i>
                    </button>
                </form>

            }
            else
            {
                <form id="reportForm"
                      asp-controller="Report"
                      asp-route-reportType="@ViewBag.ReportType"
                      asp-action="ShowReport"
                      method="post"
                      class="d-flex align-items-center m-0 flex-nowrap dev-toolbar-form">
                    <!-- Will be changed dynamically before Submit -->
                    <input type="hidden" id="actionButton" name="actionButton" />

                    <!-- PRINT DROPDOWN -->
                    <div class="btn-group">
                        <button type="button"
                                class="btn btn-sm dev-btn-screen dev-btn-toggle dropdown-toggle"
                                data-bs-toggle="dropdown" title="View On Screen">
                            <i class="fa fa-print"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item text-primary bg-primary bg-opacity-10"
                                        onclick="submitReport('ScreenList')">
                                    <i class="fa fa-list"></i> List
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item text-primary bg-primary bg-opacity-10"
                                        onclick="submitReport('ScreenDetail')">
                                    <i class="fa fa-file-alt"></i> Detail
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- PDF DROPDOWN -->
                    <div class="btn-group">
                        <button type="button"
                                class="btn btn-sm dev-btn-pdf dev-btn-toggle dropdown-toggle"
                                data-bs-toggle="dropdown" title="Download PDF">
                            <i class="fa fa-file-pdf"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item text-danger bg-danger bg-opacity-10"
                                        onclick="submitReport('PdfList')">
                                    <i class="fa fa-list"></i> List
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item text-danger bg-danger bg-opacity-10"
                                        onclick="submitReport('PdfDetail')">
                                    <i class="fa fa-file-alt"></i> Detail
                                </button>
                            </li>
                        </ul>

                    </div>

                    <!-- EXCEL DROPDOWN -->
                    <div class="btn-group">
                        <button type="button"
                                class="btn btn-sm dev-btn-excel dev-btn-toggle dropdown-toggle"
                                data-bs-toggle="dropdown" title="Export to Excel">
                            <i class="fa fa-file-excel"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item text-success bg-success bg-opacity-10"
                                        onclick="submitReport('ExcelList')">
                                    <i class="fa fa-list"></i> List
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item text-success bg-success bg-opacity-10"
                                        onclick="submitReport('ExcelDetail')">
                                    <i class="fa fa-table"></i> Detail
                                </button>
                            </li>
                        </ul>

                    </div>
                </form>
            }
        }

        <!-- TILE / GRID TOGGLE -->
        @if (Model != null)
        {

            <a asp-action="@Model.Action" asp-controller="@Model.Controller"
            asp-route-SearchText="@Model.SearchText"
               asp-route-view="@(Model.ViewType == "Tile" ? "Grid" : "Tile")"
               class="btn btn-sm btn-outline-secondary dev-btn-toggle" title="Toggle View">
                <i class="fa @(Model.ViewType == "Tile" ? "fa-th-large" : "fa-id-card")"></i>
                </a>
        }
         
    </div>
</div>
