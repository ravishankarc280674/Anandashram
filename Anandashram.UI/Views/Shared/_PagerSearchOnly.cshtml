@using Anandashram.UI.Tools.Core.Models
@model PageModel

<style>
    .toolbar {
        background-color: black;
        border-radius: 10px;
        min-height: 45px;
        padding: 8px 12px;
    }

        .toolbar .form-control {
            height: 32px;
            width: 220px;
        }

    .btn-search {
        background-color: red;
        border: none;
        color: white;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
    }

        .btn-search i {
            margin-right: 6px;
        }

    .btn-outline-secondary {
        border: 1px solid #666;
    }

    .page-link {
        color: black !important;
    }

    .page-item.active .page-link {
        color: #fff !important;
        background-color: red !important;
        border-color: red !important;
    }

    .page-item .page-link:hover {
        background-color: #f0f0f0;
    }

    .toolbar .form-check-label {
        color: white;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid d-flex justify-content-between align-items-center flex-wrap toolbar">

    <!-- LEFT SIDE -->
    <form asp-action="Index"
          asp-route-SearchText="@ViewBag.SearchText"
          asp-route-Closed="@ViewBag.Closed"
          class="d-flex align-items-center m-0 flex-nowrap">

        <input class="form-control me-2"
               type="text"
               name="SearchText"
               value="@ViewBag.SearchText"
               placeholder="Search Key" />

        <button type="submit" class="btn-search">
            <i class="fa fa-search"></i> Search
        </button>

    </form>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center flex-wrap justify-content-end gap-2">

        <!-- REPORT BUTTONS -->
        @if (Model != null)
        {
            <form asp-controller="Report"
                  asp-route-reportType="DevoteeList"
                  asp-action="ShowReport"
                  method="post" target="_blank"
                  class="d-flex align-items-center gap-1 m-0">

                <button type="submit" style="display:none"
                        class="btn btn-sm btn-outline-secondary"
                        name="actionButton" value="Screen"
                        title="View on Screen">
                    <i class="fa fa-print" style="color:#28a745;"></i>
                </button>

                <button type="submit" style="display:none"
                        class="btn btn-sm btn-outline-secondary"
                        name="actionButton" value="Pdf"
                        title="Download PDF">
                    <i class="fa fa-file-pdf" style="color:#dc3545;"></i>
                </button>
            </form>
        }

        <!-- TILE / GRID TOGGLE -->
        @if (Model != null)
        {
            @if (Model.ViewType != "Tile")
            {
                <a class="btn btn-sm btn-outline-secondary"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-route-SearchText="@Model.SearchText"
                   asp-route-view="Tile"
                   title="Switch to Tile View">
                    <i class="fa fa-id-card"></i>
                </a>
            }
            else
            {
                <a class="btn btn-sm btn-outline-secondary"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-route-SearchText="@Model.SearchText"
                   asp-route-view="Grid"
                   title="Switch to Grid View">
                    <i class="fa fa-th-large"></i>
                </a>
            }
        }

        <!-- PAGINATION -->
         @if (Model != null)
        {
        @if (Model.TotalPages > 0)
        {
            <ul class="pagination mb-0 d-flex align-items-center justify-content-end ms-2">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="1"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">First</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage - 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Prev</a>
                    </li>
                }

                @for (var pge = Model.StartPage; pge <= Model.EndPage; pge++)
                {
                    <li class="page-item @(pge == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@pge"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">@pge</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage + 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Next</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@Model.TotalPages"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Last</a>
                    </li>
                }
            </ul>
        }
        }
    </div>
</div>
