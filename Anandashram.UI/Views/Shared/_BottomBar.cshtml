@model PageModel

<style>
    .footer-toolbar {
        position: sticky;
        bottom: 0;
        z-index: 100;
        background-color: #000;
        color: white;
        border-radius: 10px;
        padding: 8px 15px;
        min-height: 45px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.4);
        font-size: 0.9rem;
    }

    .footer-toolbar p {
        margin: 0;
    }

    .footer-toolbar select {
        background-color: #1c1c1c;
        color: white;
        border: 1px solid #555;
        border-radius: 6px;
        height: 30px;
        font-size: 0.85rem;
        padding: 2px 6px;
    }

    .footer-toolbar select:focus {
        box-shadow: none;
        border-color: #dc3545;
    }

    .footer-toolbar strong {
        color: #f8f9fa;
    }
</style>

<div class="footer-toolbar">
    <!-- LEFT: Record Info -->
    <div class="d-flex align-items-center">
        <p>
            Showing <strong>@Model.StartRecord</strong> to <strong>@Model.EndRecord</strong> of <strong>@Model.TotalItems</strong> Rows
        </p>
    </div>

    <!-- CENTER: Rows per Page -->
    <div class="d-flex align-items-center gap-2">
        <span>Rows per page:</span>
        <select id="pageSelector"
                asp-items="@ViewBag.PageSizes"
                onchange="ChangePageSize(this)">
        </select>
    </div>

    <!-- RIGHT: Page Info -->
    <div class="d-flex align-items-center">
        <p>
            Page <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong>
        </p>
    </div>
</div>

<script>
    function ChangePageSize(obj) {
        const controllerName = '@this.ViewContext.RouteData.Values["controller"]';
        const actionName = '@Model.Action';
        const searchText = encodeURIComponent('@Model.SearchText' ?? '');
        const sortExpr = encodeURIComponent('@Model.SortExpression' ?? '');
        const closed = '@Model.Closed';
        const viewType = '@Model.ViewType';
        const pageSize = obj.value;

        let url = `/${controllerName}/${actionName}?pageSize=${pageSize}&SearchText=${searchText}&sortExpression=${sortExpr}&view=${viewType}`;

        if (controllerName.toLowerCase() === "devotee") {
            url += `&Closed=${closed}`;
        }

        window.location.href = url;
    }
</script>
 