@model dynamic
@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    SortModel sortModel = (SortModel)ViewData["SortModel"];
    int pg = 1;
    string searchText = ViewBag.SearchText;
    if (TempData["CurrentPage"] != null)
    {
        pg = (int)TempData["CurrentPage"];

        TempData["CurrentPage"] = pg;
    }
    PageModel pager = ViewBag.Pager;

    int pageNo = 0;
    if (ViewBag.SearchPager != null)
    {
        pager = ViewBag.SearchPager;
        pageNo = pager.CurrentPage;
    }
    ViewData["SortModel"] = sortModel;
    if (pager     != null)
    {
        ViewBag.Pager = pager;
    }
}


<table class="table">
    <thead>
        <tr style="background:#d4d454">
            <th>
                
                <i class="@sortModel.GetColumn("name").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("name").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Name</a>
            </th>
            <th>

                <i class="@sortModel.GetColumn("description").SortIcon" aria-hidden="true"></i>
                <a asp-action="Index" asp-route-sortExpression="@sortModel.GetColumn("description").SortExpression"
                   asp-route-SearchText="@ViewBag.SearchText" asp-route-PageSize="@ViewBag.PageSize">Description</a>
            </th>
            <th>
                &nbsp;
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="Name">
                        <span>@item.Name</span>
                    </td>
                    <td class="Description">
                        <span>@item.Description</span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <a onclick="showInPopup('@Url.Action("AddOrEdit", currentModel, new { id = item.Id, pg = pg, SearchText = searchText}, Context.Request.Scheme)', '@currentModel - Edit')" class="btn btn-info text-white"><i class="fas fa-pencil-alt"></i>Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" onsubmit="return jQueryAjaxDelete(this);" class="d-inline">
                                   <input type="submit" aria-hidden="true" value="Delete" class="btn btn-danger"/> 
                            </form>

                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">No Records Found</td>
            </tr>
        }
    </tbody>
</table>

