@model Anandashram.Models.AddFile

<h3>Add File</h3>
<div>
     <dl class="row">
        <dt class="col-sm-4">
            <label class="control-label" asp-for="FileName"></label>
        </dt>
        <dd class="col-sm-8">
            <div class="form-group">
                <input asp-for="FileName" class="form-control" />
                <span asp-validation-for="FileName" class="text-danger"></span>
            </div>
        </dd>
    </dl>
        <fieldset>
            <div class="text-bold">Select Upload Type</div>
            <div>
            <input type="radio" id="scanner" name="scanner" value="option1" checked="checked" onchange="showControl()">
             <label>Scan</label>

            <input type="radio" id="browse" name="scanner" value="option2" onchange="showControl()">
                <label>file</label>
            </div>
            <div id="divFile">
                <label for="file">Choose a file:</label>
                <input type="file" id="file" name="file" />
            </div>
        <div id="divScan" class="col-sm-8 btn-secondary" style="border:solid;display:none">
            <div  style="border:solid"></div>
        </div>
        
        </fieldset>

    <div class="col-sm-8 fa fa-upload">Upload</div>
</div>
<script>
    function showControl() {
        // Hide all controls
        document.getElementById('divFile').style.display = 'none';
        document.getElementById('divScan').style.display = 'none';

         const option1 = document.querySelector('input[value="option1"]').checked;
        const option2 = document.querySelector('input[value="option2"]').checked;

        document.getElementById('divScan').style.display = "option1" ? 'block' : 'none';
        document.getElementById('divFile').style.display = "option2" ? 'block' : 'none';
    }
</script>