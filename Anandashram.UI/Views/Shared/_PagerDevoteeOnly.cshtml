@using Anandashram.UI.Tools.Core.Models
@model PageModel

<style>
    .toolbar {
        background-color: black;
        border-radius: 10px;
        min-height: 45px;
        padding: 8px 12px;
    }

    .toolbar .form-control {
        height: 32px;
        width: 220px;
    }

    .page-link {
        color: black !important;
    }

    .page-item.active .page-link {
        color: #fff !important;
        background-color: red !important;
        border-color: red !important;
    }

    .page-item .page-link:hover {
        background-color: #f0f0f0;
    }

    .btn-outline-secondary {
        border: 1px solid #666;
    }
</style>

<div class="container-fluid d-flex justify-content-between align-items-center flex-wrap toolbar">

    <!-- LEFT SIDE: Search + Checkbox -->
    <form asp-action="Index"
          asp-route-SearchText="@ViewBag.SearchText"
          asp-route-PageSize="@ViewBag.PageSize"
          asp-route-Closed="@ViewBag.Closed"
          asp-route-view="@ViewBag.view"
          class="d-flex align-items-center m-0 flex-nowrap">

        <input class="form-control me-2"
               type="text" name="SearchText"
               value="@ViewBag.SearchText"
               placeholder="Search Key" />

        <button type="submit"
                class="btn btn-danger d-flex align-items-center px-3"
                style="height:32px; border-radius:8px;">
            <i class="fa fa-search me-1"></i> Search
        </button>

        <div class="form-check ms-3 d-flex align-items-center">
            <input type="checkbox"
                   asp-for="Closed"
                   onchange="this.form.submit()"
                   class="form-check-input me-1"
                   title="Include Closed" />
            <label class="form-check-label text-white small" asp-for="Closed">Closed</label>
        </div>
    </form>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center flex-wrap justify-content-end gap-2">

        @if (Model != null)
        {
            <form asp-controller="Report"
                  asp-route-reportType="DevoteeList"
                  asp-action="ShowReport"
                  method="post" target="_blank"
                  class="d-flex align-items-center gap-1 m-0">

                <button type="submit" class="btn btn-sm btn-outline-secondary"
                        name="actionButton" value="Screen" title="View on Screen">
                    <i class="fa fa-print" style="color:#28a745;"></i>
                </button>

                <button type="submit" class="btn btn-sm btn-outline-secondary"
                        name="actionButton" value="Pdf" title="Download PDF">
                    <i class="fa fa-file-pdf" style="color:#dc3545;"></i>
                </button>
                <button type="submit" class="btn btn-sm btn-outline-secondary"
                        name="actionButton" value="Excel" title="Download Excel">
                    <i class="fa fa-file-excel" style="color:#28a745;"></i>
                </button>
            </form>
        }

        @if (Model.ViewType != "Tile")
        {
            <a asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               asp-route-SearchText="@Model.SearchText"
               asp-route-Closed="@Model.Closed"
               asp-route-view="Tile"
               title="Switch to Tile View"
               class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-id-card"></i>
            </a>
        }
        else
        {
            <a asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               asp-route-SearchText="@Model.SearchText"
               asp-route-Closed="@Model.Closed"
               asp-route-view="Grid"
               title="Switch to Grid View"
               class="btn btn-sm btn-outline-secondary">
                <i class="fa fa-th-large"></i>
            </a>
        }

        <!-- PAGINATION -->
        @if (Model.TotalPages > 0)
        {
            <ul class="pagination mb-0 d-flex align-items-center justify-content-end ms-2">

                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="1"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">First</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage - 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Previous</a>
                    </li>
                }

                @for (var pge = Model.StartPage; pge <= Model.EndPage; pge++)
                {
                    <li class="page-item @(pge == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@pge"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">@pge</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage + 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Next</a>
                    </li>

                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@Model.TotalPages"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Last</a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
