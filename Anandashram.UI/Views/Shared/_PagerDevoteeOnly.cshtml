@using Anandashram.UI.Tools.Core.Models
@model PageModel

<style>
    .page-link {
        color: black !important;
    }

</style>

<div class="dev-toolbar container-fluid d-flex justify-content-between align-items-center flex-wrap">

    <!-- LEFT SIDE: Search + Checkbox -->
    <form asp-action="Index"
          asp-route-SearchText="@ViewBag.SearchText"
          asp-route-PageSize="@ViewBag.PageSize"
          asp-route-Closed="@ViewBag.Closed"
          asp-route-view="@ViewBag.view"
          class="d-flex align-items-center m-0 flex-nowrap dev-toolbar-form">

        <input class="form-control dev-search-input me-2"
               type="text" name="SearchText"
               value="@ViewBag.SearchText"
               placeholder="Search Key" />

        <button type="submit" class="btn dev-btn-search d-flex align-items-center px-3">
            <i class="fa fa-search me-1"></i> Search
        </button>

        <div class="form-check ms-3 d-flex align-items-center">
            <input type="checkbox"
                   asp-for="Closed"
                   onchange="this.form.submit()"
                   class="form-check-input me-1"
                   title="Include Closed" />
            <label class="form-check-label small text-muted" asp-for="Closed">Include Closed</label>
        </div>
    </form>

    <!-- RIGHT SIDE -->
    <div class="d-flex align-items-center gap-2 dev-toolbar-actions">

        @if (Model != null)
        {
            <form asp-controller="Report"
                  asp-route-reportType="DevoteeList"
                  asp-action="ShowReport"
                  method="post"
                  class="d-flex gap-1 m-0">

                <button type="submit" class="btn dev-btn-screen"
                        name="actionButton" value="Screen" title="View On Screen">
                    <i class="fa fa-print"></i>
                </button>

                <button type="submit" class="btn dev-btn-pdf"
                        name="actionButton" value="Pdf" title="Download PDF">
                    <i class="fa fa-file-pdf"></i>
                </button>

                <button type="submit" class="btn dev-btn-excel"
                        name="actionButton" value="Excel" title="Download Excel">
                    <i class="fa fa-file-excel"></i>
                </button>
            </form>
        }

            <a asp-action="@Model.Action" asp-controller="@Model.Controller"
               asp-route-SearchText="@Model.SearchText"
               asp-route-Closed="@Model.Closed"
               asp-route-sortExpression="@Model.SortExpression"
               asp-route-pg="@Model.CurrentPage"
               asp-route-PageSize="@Model.PageSize"
               asp-route-view="@(Model.ViewType == "Tile" ? "Grid" : "Tile")"
               class="btn btn-sm btn-outline-secondary dev-btn-toggle" title="Toggle View">
                <i class="fa @(Model.ViewType == "Tile" ? "fa-th-large" : "fa-id-card")"></i>
            </a>
        <!-- PAGINATION -->
        @if (Model.TotalPages > 0)
        {
            <ul class="pagination mb-0 d-flex align-items-center justify-content-end ms-2">

                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="1"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-sortExpression="@Model.SortExpression"
                           asp-route-view="@Model.ViewType">First</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage - 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-sortExpression="@Model.SortExpression"
                           asp-route-view="@Model.ViewType">Previous</a>
                    </li>
                }

                @for (var pge = Model.StartPage; pge <= Model.EndPage; pge++)
                {
                    <li class="page-item @(pge == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@pge"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-sortExpression="@Model.SortExpression"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">@pge</a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@(Model.CurrentPage + 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Closed="@Model.Closed"
                           asp-route-sortExpression="@Model.SortExpression"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Next</a>
                    </li>

                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="@Model.Controller"
                           asp-action="@Model.Action"
                           asp-route-pg="@Model.TotalPages"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-sortExpression="@Model.SortExpression"
                           asp-route-Closed="@Model.Closed"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-view="@Model.ViewType">Last</a>
                    </li>
                }
            </ul>
        }
</div>
</div>
