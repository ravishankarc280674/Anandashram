@using Anandashram.UI.Tools.Core.Models

@model PageModel
<style>
	.page-link {
		color: black !important;
	}

	.page-item.active .page-link {
		z-index: 3;
		color: #fff;
		background-color: red !important;
		border-color: red;
	}
</style>

<div class="container btn-group" style="background-color:black; border-radius:10px; height:45px;">
	<div class="col-4 p-0 justify-content-end mt-1">
		<form asp-action="index">
			<span class="btn-group">
			<input class="form-control" type="text"
				   name="SearchText"
				   value="@ViewBag.SearchText"
				   placeholder="Search Key" />
			<span class="ml-2 btn-group btn-danger" style="border-radius:10px;">
				<i class="pl-2 fa fa-search align-self-center" aria-hidden="true"></i>
				<input class="btn btn-sm font-weight-bold text-white"
					   type="submit" value="Search" />
			</span>
			</span>
			&nbsp;
			<input type="checkbox" onchange="this.form.submit()" name="Closed" value="true" checked="@ViewBag.Closed" title="Include Closed" />
		</form>
	</div>

	<div class="container mt-1">
		<ul class="pagination justify-content-end">
			@if (Model.ViewType != "Tile")
			{
				<li class="page-item">
					<a class="" asp-controller="@Model.Controller" asp-action="@Model.Action" aria-hidden="true"
					   asp-route-SearchText="@Model.SearchText" asp-route-view="Tile" title="Tile View">
						<span class="btn btn-sm btn-outline-secondary">
							<i class="fa fa-id-card" aria-hidden="true" title="Tile View"></i>
						</span>
					</a>
				</li>
			}
			else
			{
				<li class="page-item">
					<a class="" asp-controller="@Model.Controller" asp-action="@Model.Action" aria-hidden="true"
					   asp-route-SearchText="@Model.SearchText" asp-route-view="Grid" title="Grid View">
						<span class="btn btn-sm btn-outline-secondary">
							<i class="fa fa-grid-horizontal" aria-hidden="true" title="Grid View"></i>
						</span>
					</a>
				</li>
			}
		@if (Model.TotalPages > 0)
		{
			<ul class="pagination justify-content-end">

				@if (Model.CurrentPage > 1)
				{
					<li class="page-item">
						<a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-pg="1"
						   asp-route-SearchText="@Model.SearchText" asp-route-pageSize="@Model.PageSize">First</a>
					</li>
					<li>
						<a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
						   asp-route-pg="@(Model.CurrentPage - 1)"
						   asp-route-SearchText="@Model.SearchText" asp-route-pageSize="@Model.PageSize">Previous</a>
					</li>
				}
				@for (var pge = Model.StartPage; pge <= Model.EndPage; pge++)
				{
					<li class="page-item @(pge == Model.CurrentPage ? "active" : "")">
						@if (pge != Model.CurrentPage)
						{
							<a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-pg="@pge"
							   asp-route-SearchText="@Model.SearchText" asp-route-pageSize="@Model.PageSize"> @pge </a>
						}
						else
						{
							<span class="page-link">@pge</span>
						}
					</li>

				}
				@if (Model.CurrentPage < Model.TotalPages)
				{
					<li class="page-item">
						<a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
						   asp-route-SearchText="@Model.SearchText" asp-route-pg="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
					</li>
					<li class="page-item">
						<a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-sortExpression="@Model.SortExpression"
						   asp-route-SearchText="@Model.SearchText" asp-route-pg="@(Model.TotalPages)" asp-route-PageSize="@Model.PageSize">Last</a>
					</li>
				}
			</ul>
		}
	</div>

</div>


