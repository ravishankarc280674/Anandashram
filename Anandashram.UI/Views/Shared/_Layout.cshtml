@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anandashram Devotee Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/font-awesome/css/all.min.css" />
    <environment include="Development">
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/site.min.css" />
    </environment>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <style>
        /* GLOBAL STYLE */
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav.navbar {
            background-color: #0f5132 !important; /* Deep green */
            height: 56px;
            z-index: 1050;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .navbar-user {
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* SIDEBAR */
            #sidebar .sidebar-link {
                display: block;
                color: #fff;
                text-decoration: none;
                padding: 8px 0;
                font-weight: 500;
                transition: all 0.2s ease;
            }

                #sidebar .sidebar-link:hover,
                #sidebar .sidebar-link.active {
                    color: #6d7791;
                }

            #sidebar .submenu {
                margin-top: 0.25rem;
            }

            #sidebar .submenu-link {
                display: block;
                color: #fff;
                padding: 5px 0;
                text-decoration: none;
                font-size: 1.95rem;
                transition: color 0.2s ease;
            }

                #sidebar .submenu-link:hover {
                color: #6d7791;
                }

        #sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 56px;
            left: 0;
            background-color: #2e502f; /* Medium green */
            color: #fff;
            transition: all 0.3s ease;
            overflow-y: auto;
            font-weight: 800;
        }

            #sidebar.collapsed {
                width: 70px;
            }

            #sidebar .logo {
                text-align: center;
                padding: 10px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            }

                #sidebar .logo img {
                    max-height: 70px;
                }

           
                #sidebar a:hover {
                    background-color: #1b5e20;
                    color: #fff;
                }

                #sidebar a.active {
                    background-color: #43a047;
                    color: white;
                    border-left: 4px solid #a5d6a7;
                    font-weight: 600;
                }

            #sidebar .submenu a {
                padding-left: 15px;
                font-size: 0.9rem;
            }

            #sidebar i {
                width: 20px;
            }

        /* CONTENT */
        #content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s ease;
            min-height: calc(100vh - 70px);
            background-color: white;
        }

        #sidebar.collapsed + #content {
            margin-left: 70px;
        }

        main {
            margin-top: 60px;
        }

        /* FOOTER */
        footer {
            background-color: #0f5132 !important;
            color: white;
            padding: 8px 0;
            text-align: center;
            font-size: 0.9rem;
        }

        /* TOGGLE BUTTON */
        .sidebar-toggle {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            margin-right: 10px;
        }

        /* Scrollbar */
        #sidebar::-webkit-scrollbar {
            width: 6px;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }

        /* Collapsed text hide */
        #sidebar.collapsed .menu-text {
            display: none;
        }
    </style>
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-dark fixed-top">
        <div class="container-fluid">
            <button id="sidebarToggle" class="sidebar-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Anandashram</a>

            <div class="navbar-user ms-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    <span><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-sm">Login</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-sm">Register</a>
                }
            </div>
        </div>
    </nav>

    <!-- SIDEBAR -->
   <div id="sidebar" class="d-flex flex-column">
    <div class="logo text-center py-3">
        <img src="~/images/company_logo.png" alt="Anandashram Logo" class="img-fluid" style="max-height: 70px;" />
    </div>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <!-- Dashboard -->
        <a asp-controller="Home" asp-action="Index"
           class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="fas fa-tachometer-alt me-2"></i> Dashboard
        </a>

        <!-- Devotee Menu -->
        <a href="#" class="sidebar-link" data-bs-toggle="collapse" data-bs-target="#menuDevotee" aria-expanded="false">
            <i class="fas fa-user me-2"></i> Devotee <i class="fas fa-angle-down float-end mt-1"></i>
        </a>
        <div class="collapse submenu ps-4" id="menuDevotee">
            <a asp-controller="Devotee" asp-action="Index" class="submenu-link">
                <i class="fas fa-list me-2"></i> List
            </a>
            <a asp-controller="DevoteeCategory" asp-action="Index" class="submenu-link">
                <i class="fas fa-tags me-2"></i> Category
            </a>
        </div>

        <!-- Infrastructure Menu -->
        <a href="#" class="sidebar-link" data-bs-toggle="collapse" data-bs-target="#menuInfra" aria-expanded="false">
            <i class="fas fa-building me-2"></i> Infrastructure <i class="fas fa-angle-down float-end mt-1"></i>
        </a>
        <div class="collapse submenu ps-4" id="menuInfra">
            <a asp-controller="Building" asp-action="Index" class="submenu-link">
                <i class="fas fa-city me-2"></i> Building
            </a>
            <a asp-controller="Block" asp-action="Index" class="submenu-link">
                <i class="fas fa-cubes me-2"></i> Block
            </a>
            <a asp-controller="Floor" asp-action="Index" class="submenu-link">
                <i class="fas fa-layer-group me-2"></i> Floor
            </a>
            <a asp-controller="Room" asp-action="Index" class="submenu-link">
                <i class="fas fa-door-open me-2"></i> Room
            </a>
        </div>

        <!-- Reservation Menu -->
        <a href="#" class="sidebar-link" data-bs-toggle="collapse" data-bs-target="#menuResv" aria-expanded="false">
            <i class="fas fa-calendar-check me-2"></i> Reservation <i class="fas fa-angle-down float-end mt-1"></i>
        </a>
        <div class="collapse submenu ps-4" id="menuResv">
            <a asp-controller="Reservation" asp-action="Index" class="submenu-link">
                <i class="fas fa-list-alt me-2"></i> List
            </a>
        </div>

        <!-- Reports Menu -->
        <a href="#" class="sidebar-link" data-bs-toggle="collapse" data-bs-target="#menuReports" aria-expanded="false">
            <i class="fas fa-file-alt me-2"></i> Reports <i class="fas fa-angle-down float-end mt-1"></i>
        </a>
        <div class="collapse submenu ps-4" id="menuReports">
            <a asp-controller="Report" asp-action="AllocationViewer" class="submenu-link">
                <i class="fas fa-bed me-2"></i> Room Allocation
            </a>
                <a asp-controller="Report" asp-action="CheckInViewer" class="submenu-link">
                    <i class="fas fa-door-closed me-2"></i> Check-In
                </a>
                <a asp-controller="Report" asp-action="CheckOutViewer" class="submenu-link">
                <i class="fas fa-door-closed me-2"></i> Check-Out
            </a>
                <a asp-controller="Reservation" asp-action="ReservationTimeline" class="submenu-link">
                    <i class="fas fa-list-alt me-2"></i> Reservation Chart
                </a>
        </div>
            <!-- Administartor Menu -->
            <a href="#" class="sidebar-link" data-bs-toggle="collapse" data-bs-target="#menuAdmin" aria-expanded="false">
                <i class="fas fa-file-alt me-2"></i> Administrator <i class="fas fa-angle-down float-end mt-1"></i>
            </a>
            <div class="collapse submenu ps-4" id="menuAdmin">
                <a asp-controller="Reservation" asp-action="CloseReservations" class="submenu-link">
                    <i class="fas fa-bed me-2"></i> Close Reservation(s)
                </a>
            </div>
    }
</div>


    <!-- MAIN CONTENT -->
    <div id="content">
        <main>
            @RenderBody()
        </main>
        <div class="modal" tabindex="-1" id="form-modal" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <i class="fas fa-comment-dollar text-success"></i><h5 class="modal-title">Modal title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Modal body text goes here.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="loaderbody" id="loaderbody">
            <div class="loader">
            </div>
        </div>
    </div>
   
    <div class="modal fade" id="imageModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen">
            <div class="modal-content bg-dark">
                <div class="modal-body d-flex justify-content-center align-items-center p-0">
                    <img id="fullImage" class="img-fluid" style="max-height:100vh;" />
                </div>
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                        data-bs-dismiss="modal"></button>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/webcamjs/webcam.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notify.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
<script>
      document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
              new bootstrap.Tooltip(el, { container: 'body' });
          });
      });

    // Sidebar toggle
    $("#sidebarToggle").click(function () {
        $("#sidebar").toggleClass("collapsed");
        $("#content").toggleClass("expanded");
    });
      document.addEventListener("DOMContentLoaded", () => {
        const img = document.getElementById("profilePic");
        const modalImage = document.getElementById("fullImage");
        const modal = new bootstrap.Modal(document.getElementById("imageModal"));

        img.addEventListener("click", () => {
            modalImage.src = img.src;
            modal.show();
        });
    });
</script>