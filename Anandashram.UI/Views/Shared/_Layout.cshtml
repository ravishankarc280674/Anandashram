@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anandashram Devotee Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <style>
        /* GLOBAL STYLE */
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            overflow-x: hidden;
        }

        /* NAVBAR */
        nav.navbar {
            background-color: #1b5e20; /* Deep green */
            height: 56px;
            z-index: 1050;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .navbar-user {
            color: white;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* SIDEBAR */
        #sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 56px;
            left: 0;
            background-color: #2e7d32; /* Medium green */
            color: #fff;
            transition: all 0.3s ease;
            overflow-y: auto;
        }

            #sidebar.collapsed {
                width: 70px;
            }

            #sidebar .logo {
                text-align: center;
                padding: 10px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            }

                #sidebar .logo img {
                    max-height: 70px;
                }

            #sidebar a {
                color: #e8f5e9;
                text-decoration: none;
                padding: 10px 15px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 0.95rem;
                transition: all 0.2s ease;
            }

                #sidebar a:hover {
                    background-color: #1b5e20;
                    color: #fff;
                }

                #sidebar a.active {
                    background-color: #43a047;
                    color: white;
                    border-left: 4px solid #a5d6a7;
                    font-weight: 600;
                }

            #sidebar .submenu a {
                padding-left: 35px;
                font-size: 0.9rem;
            }

            #sidebar i {
                width: 20px;
            }

        /* CONTENT */
        #content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s ease;
            min-height: calc(100vh - 70px);
            background-color: white;
        }

        #sidebar.collapsed + #content {
            margin-left: 70px;
        }

        main {
            margin-top: 60px;
        }

        /* FOOTER */
        footer {
            background-color: #1b5e20;
            color: white;
            padding: 8px 0;
            text-align: center;
            font-size: 0.9rem;
        }

        /* TOGGLE BUTTON */
        .sidebar-toggle {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            margin-right: 10px;
        }

        /* Scrollbar */
        #sidebar::-webkit-scrollbar {
            width: 6px;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }

        /* Collapsed text hide */
        #sidebar.collapsed .menu-text {
            display: none;
        }
    </style>
</head>

<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-dark fixed-top">
        <div class="container-fluid">
            <button id="sidebarToggle" class="sidebar-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Anandashram</a>

            <div class="navbar-user ms-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    <span><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-sm">Login</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-sm">Register</a>
                }
            </div>
        </div>
    </nav>

    <!-- SIDEBAR -->
    <div id="sidebar">
        <div class="logo">
            <img src="~/images/company_logo.png" alt="Anandashram Logo" />
        </div>

        <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="fas fa-tachometer-alt"></i> <span class="menu-text">Dashboard</span>
        </a>

        <a href="#" data-bs-toggle="collapse" data-bs-target="#menuDevotee" aria-expanded="false">
            <i class="fas fa-user"></i> <span class="menu-text">Devotee</span> <i class="fas fa-angle-down"></i>
        </a>
        <div class="collapse submenu" id="menuDevotee">
            <a asp-controller="Devotee" asp-action="Index"><i class="fas fa-list"></i>List</a>
            <a asp-controller="DevoteeCategory" asp-action="Index"><i class="fas fa-tags"></i>Category</a>
            <a asp-controller="DevoteeGroup" asp-action="Index"><i class="fas fa-users"></i>Groups</a>
        </div>

        <a href="#" data-bs-toggle="collapse" data-bs-target="#menuInfra" aria-expanded="false">
            <i class="fas fa-building"></i> <span class="menu-text">Infrastructure</span> <i class="fas fa-angle-down"></i>
        </a>
        <div class="collapse submenu" id="menuInfra">
            <a asp-controller="Building" asp-action="Index"><i class="fas fa-city"></i>Building</a>
            <a asp-controller="Block" asp-action="Index"><i class="fas fa-cubes"></i>Block</a>
            <a asp-controller="Floor" asp-action="Index"><i class="fas fa-layer-group"></i>Floor</a>
            <a asp-controller="Room" asp-action="Index"><i class="fas fa-door-open"></i>Room</a>
        </div>

        <a href="#" data-bs-toggle="collapse" data-bs-target="#menuResv" aria-expanded="false">
            <i class="fas fa-calendar-check"></i> <span class="menu-text">Reservation</span> <i class="fas fa-angle-down"></i>
        </a>
        <div class="collapse submenu" id="menuResv">
            <a asp-controller="Reservation" asp-action="Index"><i class="fas fa-list-alt"></i>List</a>
            <a asp-controller="Reservation" asp-action="Create"><i class="fas fa-plus-circle"></i>New Booking</a>
        </div>

        <a href="#" data-bs-toggle="collapse" data-bs-target="#menuReports" aria-expanded="false">
            <i class="fas fa-file-alt"></i> <span class="menu-text">Reports</span> <i class="fas fa-angle-down"></i>
        </a>
        <div class="collapse submenu" id="menuReports">
            <a asp-controller="Report" asp-action="RoomViewer"><i class="fas fa-bed"></i>Room Allocation</a>
            <a asp-controller="Report" asp-action="ReportViewer"><i class="fas fa-door-closed"></i>Checkout</a>
            <a asp-controller="Report" asp-action="Summary"><i class="fas fa-chart-pie"></i>Summary</a>
        </div>

        <a href="#" data-bs-toggle="collapse" data-bs-target="#menuSettings" aria-expanded="false">
            <i class="fas fa-cog"></i> <span class="menu-text">Settings</span> <i class="fas fa-angle-down"></i>
        </a>
        <div class="collapse submenu" id="menuSettings">
            <a asp-controller="User" asp-action="Index"><i class="fas fa-user-shield"></i>Users</a>
            <a asp-controller="Role" asp-action="Index"><i class="fas fa-user-lock"></i>Roles</a>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div id="content">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer>
        &copy; 2025 - Anandashram | <a asp-controller="Home" asp-action="Privacy" class="text-white">Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar toggle
        $("#sidebarToggle").click(function () {
            $("#sidebar").toggleClass("collapsed");
            $("#content").toggleClass("expanded");
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
