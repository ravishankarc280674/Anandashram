@model Anandashram.Models.Room
@{
    ViewData["Title"] = "Room - Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Room - Create</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CreatedBy" />
            <input type="hidden" asp-for="CreatedDate" />
            <dl class="row">
                <dt class="col-sm-2">
                <label asp-for="Name" class="control-label"></label>
                </dt>
                <dd class="col-sm-10">
                    <div class="form-group">
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </dd>
                <dt class="col-sm-2">
                            <label asp-for="Description" class="control-label"></label>
                </dt>
                <dd class="col-sm-10">
                    <div class="form-group">
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
               </dd>
                <dt class="col-sm-2">
                        <label asp-for="BuildingId" class="control-label"></label>
                </dt>
                <dd class="col-sm-10">
                    <div class="form-group">
                        <select asp-for="BuildingId" class="form-control" asp-items="ViewBag.BuildingId"></select>
                    </div>
                </dd>
                <dt class="col-sm-2">
                    <label asp-for="BlockId" class="control-label"></label>
                </dt>
                <dd class="col-sm-10">
                    <div class="form-group">
                        <select asp-for="BlockId" class="form-control" asp-items="ViewBag.BlockId"></select>
                    </div>
                </dd>
                <dt class="col-sm-2">
                    <label asp-for="FloorId" class="control-label"></label>
                </dt>
                <dd class="col-sm-10">
                    <div class="form-group">
                        <select asp-for="FloorId" class ="form-control" asp-items="ViewBag.FloorId"></select>
                    </div>
                </dd>
                <dt class="col-sm-2">
                    <label asp-for="Capacity" class="control-label"></label>
                    </dd>
                <dt class="col-sm-2">
                    <div class="form-group">
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            </dt>
            </dl>
            <br />
            <div class="form-group btn-group">
                <input type="submit" value="Create" class="btn btn-primary" />&nbsp;
                <a class="btn btn-secondary" asp-action="index"
                   asp-route-pg="@TempData.Peek("CurrentPage")">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
