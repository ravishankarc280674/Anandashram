@model Anandashram.Models.Room

@{
    ViewData["Title"] = "Delete";
}

@{
    string currentModel = Helper.GetTypeNames(Model.GetType().ToString());
    ViewData["Title"] = currentModel + " - Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div>
    <h3>@currentModel - Delete</h3>
    <hr />
    <div class="text-danger">
        <h5>Are you sure you want to delete this Record?</h5>
    </div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BuildingId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BuildingId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BlockId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BlockId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FloorId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FloorId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedBy)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModifiedBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModifiedBy)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModifiedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModifiedDate)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />&nbsp;
        <a class="btn btn-secondary" asp-action="index"
           asp-route-pg="@TempData.Peek("CurrentPage")">Back</a>
    </form>
</div>
