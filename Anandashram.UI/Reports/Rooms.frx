<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp">
  <Dictionary>
    <BusinessObjectDataSource Name="Company" ReferenceName="Company" Enabled="True">
      <Column Name="Name" DataType="System.String"/>
      <Column Name="Established" DataType="System.Int32"/>
      <Column Name="AddressLine1" DataType="System.String"/>
      <Column Name="AddressLine2" DataType="System.String"/>
      <Column Name="State" DataType="System.String"/>
      <Column Name="Country" DataType="System.String"/>
      <Column Name="PinCode" DataType="System.String"/>
      <Column Name="Mobile" DataType="System.String"/>
      <Column Name="Email" DataType="System.String"/>
      <Column Name="Website" DataType="System.String"/>
    </BusinessObjectDataSource>

    <BusinessObjectDataSource Name="Rooms" ReferenceName="Rooms" Enabled="True">
      <Column Name="RoomName" DataType="System.String"/>
      <Column Name="BuildingName" DataType="System.String"/>
      <Column Name="BlockName" DataType="System.String"/>
      <Column Name="FloorName" DataType="System.String"/>
      <Column Name="Capacity" DataType="System.Int32"/>
    </BusinessObjectDataSource>

    <Parameter Name="Title" DataType="System.String"/>
  </Dictionary>


  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297"
              LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10">

    <ReportTitleBand Height="80">
      <TextObject Width="750" Height="20" Text="[Company.Name]" HorzAlign="Center"
                  Font="Arial,14pt,Bold"/>
      <TextObject Top="20" Width="750" Height="16"
                  Text="[Title]" HorzAlign="Center"
                  Font="Arial,12pt,Bold"/>
      <TextObject Top="40" Width="750" Height="16"
                  Text="[Date]"
                  HorzAlign="Center" Font="Arial,9pt"/>
    </ReportTitleBand>


    <!-- TABLE HEADER -->
    <DataHeaderBand Height="24" DataSource="Rooms">
      <TableObject Width="750" Height="24">
        <TableColumn Width="230"/>
        <TableColumn Width="230"/>
        <TableColumn Width="100"/>
        <TableColumn Width="140"/>
        <TableColumn Width="50"/>

        <TableRow Height="24" Fill.Color="#28a745">
          <TableCell Text="Building" TextFill.Color="White" Border.Lines="All"
                     HorzAlign="Center" VertAlign="Middle"/>
          <TableCell Text="Block" TextFill.Color="White" Border.Lines="All"
                     HorzAlign="Center" VertAlign="Middle"/>
          <TableCell Text="Floor" TextFill.Color="White" Border.Lines="All"
                     HorzAlign="Center" VertAlign="Middle"/>
          <TableCell Text="Room" TextFill.Color="White" Border.Lines="All"
                     HorzAlign="Center" VertAlign="Middle"/>
          <TableCell Text="Capacity" TextFill.Color="White" Border.Lines="All"
                     HorzAlign="Right" VertAlign="Middle"/>
        </TableRow>
      </TableObject>
    </DataHeaderBand>


    <!-- MERGED ROWS WORK HERE -->
    <DataBand Name="DetailBand" DataSource="Rooms" Height="20">
      <TableObject Width="750" Height="20">
        <TableColumn Width="230"/>
        <TableColumn Width="230"/>
        <TableColumn Width="100"/>
        <TableColumn Width="140"/>
        <TableColumn Width="50"/>

        <TableRow Height="20">

          <TableCell Border.Lines="All"
                     Text="[Rooms.BuildingName]"
                     RepeatValues="false"  HorzAlign="Right" VertAlign="Middle"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.BlockName]"
                     RepeatValues="false"  HorzAlign="Right" VertAlign="Middle"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.FloorName]"
                     RepeatValues="false"  HorzAlign="Right" VertAlign="Middle"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.RoomName]"
                      HorzAlign="Right" VertAlign="Middle"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.Capacity]"
                     HorzAlign="Right" VertAlign="Middle"/>

        </TableRow>
      </TableObject>
    </DataBand>


    <ReportSummaryBand Height="22">
      <TextObject Width="750" Height="22"
                  Text="Total Rooms: [Count([Rooms.RoomName])]   Total Capacity: [Sum([Rooms.Capacity])]"
                  HorzAlign="Right" Font="Arial,10pt,Bold"/>
    </ReportSummaryBand>

  </ReportPage>

</Report>
