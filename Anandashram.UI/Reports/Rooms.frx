<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="2025-11-16">

  <Dictionary>
    <BusinessObjectDataSource Name="Rooms" ReferenceName="Rooms" Enabled="True">
      <Column Name="Name" DataType="System.String"/>
      <Column Name="BuildingId" DataType="System.Int32"/>
      <Column Name="BlockId" DataType="System.Int32"/>
      <Column Name="FloorId" DataType="System.Int32"/>
      <Column Name="Capacity" DataType="System.Int32"/>
      <Column Name="BuildingName" DataType="System.String"/>
      <Column Name="BlockName" DataType="System.String"/>
      <Column Name="FloorName" DataType="System.String"/>
    </BusinessObjectDataSource>
  </Dictionary>


  <ReportPage Name="Page1"
              PaperWidth="210" PaperHeight="297"
              LeftMargin="10" RightMargin="10"
              TopMargin="10" BottomMargin="10">

    <!-- HEADER -->
    <PageHeaderBand Height="35">
      <TextObject Width="750" Height="20"
                  Text="Room Capacity Report"
                  HorzAlign="Center"
                  Font="Arial,12pt,Bold"/>
      <TextObject Width="750" Top="20" Height="14"
                  Text="Printed: [FormatDateTime(Now(),'dd-MM-yyyy HH:mm')]"
                  HorzAlign="Center"
                  Font="Arial,8pt"/>
    </PageHeaderBand>


    <!-- TABLE HEADER -->
    <DataHeaderBand Height="24" DataSource="Rooms">
      <TableObject Name="tblHeader" Width="750" Height="24">
        <TableColumn Width="150"/>
        <TableColumn Width="150"/>
        <TableColumn Width="130"/>
        <TableColumn Width="200"/>
        <TableColumn Width="120"/>

        <TableRow Height="24" Fill.Color="#28a745">
          <TableCell Text="Building" TextFill.Color="White" Border.Lines="All" HorzAlign="Center"/>
          <TableCell Text="Block" TextFill.Color="White" Border.Lines="All" HorzAlign="Center"/>
          <TableCell Text="Floor" TextFill.Color="White" Border.Lines="All" HorzAlign="Center"/>
          <TableCell Text="Room Name" TextFill.Color="White" Border.Lines="All" HorzAlign="Center"/>
          <TableCell Text="Capacity" TextFill.Color="White" Border.Lines="All" HorzAlign="Right"/>
        </TableRow>
      </TableObject>
    </DataHeaderBand>


    <!-- DETAILS -->
    <DataBand Name="RoomBand" DataSource="Rooms" Height="20">
      <TableObject Name="tblDetail" Width="750" Height="20">
        <TableColumn Width="150"/>
        <TableColumn Width="150"/>
        <TableColumn Width="130"/>
        <TableColumn Width="200"/>
        <TableColumn Width="120"/>

        <TableRow Height="20"
                  Fill.Color="IIf([Row#] % 2 == 0, '#e9f7ea', 'Transparent')">

          <TableCell Border.Lines="All"
                     Text="[Rooms.BuildingName]"
                     RepeatOnEveryPage="true"
                     RepeatValues="false"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.BlockName]"
                     RepeatOnEveryPage="true"
                     RepeatValues="false"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.FloorName]"
                     RepeatOnEveryPage="true"
                     RepeatValues="false"/>

          <TableCell Border.Lines="All"
                     Text="[Rooms.Name]"/>

          <TableCell Border.Lines="All"
                     HorzAlign="Right"
                     Text="[Rooms.Capacity]"/>
        </TableRow>
      </TableObject>
    </DataBand>


    <!-- REPORT SUMMARY -->
    <ReportSummaryBand Height="22">
      <TextObject Width="750" Height="22"
                  Text="TOTAL ROOMS: [Count([Rooms.BuildingId])]    TOTAL CAPACITY: [Sum([Rooms.Capacity])]"
                  HorzAlign="Right"
                  Font="Arial,10pt,Bold"/>
    </ReportSummaryBand>


    <!-- FOOTER -->
    <PageFooterBand Height="15">
      <TextObject Width="350" Text="Page [Page#]/[TotalPages#]" Font="Arial,8pt"/>
    </PageFooterBand>

  </ReportPage>

</Report>
