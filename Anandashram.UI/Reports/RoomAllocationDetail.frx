<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Created="2025-11-10">
  <Dictionary>
    <BusinessObjectDataSource Name="Company" ReferenceName="Company" DataType="null" Enabled="True">
      <Column Name="Name" DataType="System.String"/>
      <Column Name="Established" DataType="System.Int32"/>
      <Column Name="AddressLine1" DataType="System.String"/>
      <Column Name="AddressLine2" DataType="System.String"/>
      <Column Name="State" DataType="System.String"/>
      <Column Name="Country" DataType="System.String"/>
      <Column Name="PinCode" DataType="System.String"/>
      <Column Name="Mobile" DataType="System.String"/>
      <Column Name="Email" DataType="System.String"/>
      <Column Name="Website" DataType="System.String"/>
    </BusinessObjectDataSource>

    <BusinessObjectDataSource Name="Rooms" ReferenceName="Rooms" DataType="System.Collections.Generic.List`1[[RoomReportDTO]]" Enabled="true">
      <Column Name="Id" DataType="System.Int32"/>
      <Column Name="RoomName" DataType="System.String"/>
      <Column Name="BuildingName" DataType="System.String"/>
      <Column Name="BlockName" DataType="System.String"/>
      <Column Name="FloorName" DataType="System.String"/>
      <Column Name="Capacity" DataType="System.Int32"/>
      <Column Name="TotalAllocated" DataType="System.Int32"/>
      <Column Name="TotalRemaining" DataType="System.Int32"/>

      <BusinessObjectDataSource Name="Reservations" DataType="System.Collections.Generic.List`1[[ReservationReportDTO]]" Enabled="true">
        <Column Name="DevoteeCode" DataType="System.String"/>
        <Column Name="DevoteeName" DataType="System.String"/>
        <Column Name="DevoteeCategoryName" DataType="System.String"/>
        <Column Name="FromDate" DataType="System.DateTime"/>
        <Column Name="Allocated" DataType="System.Int32"/>
        <Column Name="Closed" DataType="System.Boolean"/>
      </BusinessObjectDataSource>
    </BusinessObjectDataSource>

    <Parameter Name="Title" DataType="System.String"/>
  </Dictionary>

  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="15">

    <!-- Company Header -->
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="189">
      <TextObject Name="Text10" Width="718.2" Height="18.9" Text="[Company.Name]" AutoWidth="true" HorzAlign="Center" VertAlign="Center" Font="Arial, 14.25pt, style=Bold"/>
      <TextObject Name="Text17" Top="18.9" Width="718.2" Height="18.9" Text="Estd: [Company.Established]" HorzAlign="Center" Font="Arial, 11.25pt"/>
      <TextObject Name="Text18" Top="122.85" Width="718.2" Height="37.8" Border.Lines="Top, Bottom" Border.TopLine.Style="Double" Border.BottomLine.Style="Double" Text="[Title]" HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
      <TextObject Name="Text19" Top="37.8" Width="718.2" Height="20.79" Text="[Company.AddressLine1] [Company.AddressLine2]" HorzAlign="Center" Font="Arial, 11.25pt"/>
      <TextObject Name="Text20" Top="56.7" Width="718.2" Height="28.35" Text="[Company.State], [Company.Country] - [Company.PinCode]" HorzAlign="Center" Font="Arial, 11.25pt"/>
      <TextObject Name="Text24" Top="75.6" Width="718.2" Height="18.9" Text="Mobile: [Company.Mobile], Email: [Company.Email]" HorzAlign="Center" Font="Arial, 11.25pt"/>
      <TextObject Name="Text25" Top="94.5" Width="718.2" Height="18.9" Text="Website: [Company.Website]" HorzAlign="Center" Font="Arial, 11.25pt"/>
    </ReportTitleBand>

    <!-- Group by Room -->
    <GroupHeaderBand Name="RoomGroupHeader" Condition="[Rooms.Id]" Height="35">
      <TextObject Name="RoomInfo" Width="1047" Height="18"
                  Text="Room: [Rooms.RoomName]   Building: [Rooms.BuildingName]   Block: [Rooms.BlockName]   Floor: [Rooms.FloorName]"
                  Font="Arial,10pt,style=Bold"
                  Fill.Color="#E0E0E0"/>
      <TextObject Name="RoomStats" Top="18" Width="1047" Height="17"
                  Text="Capacity: [Rooms.Capacity]   Total Allocated: [Rooms.TotalAllocated]   Remaining: [Rooms.TotalRemaining]"
                  Font="Arial,9pt,style=Bold"
                  Fill.Color="#F2F2F2"/>
    </GroupHeaderBand>

    <!-- Reservation Details -->
    <DataBand Name="ReservationData" DataSource="Rooms.Reservations" Height="18">
      <TextObject Name="TextCode" Left="0" Width="80" Text="[Rooms.Reservations.DevoteeCode]" Font="Arial,9pt"/>
      <TextObject Name="TextName" Left="90" Width="150" Text="[Rooms.Reservations.DevoteeName]" Font="Arial,9pt"/>
      <TextObject Name="TextCat" Left="250" Width="120" Text="[Rooms.Reservations.DevoteeCategoryName]" Font="Arial,9pt"/>
      <TextObject Name="TextFrom" Left="380" Width="90" Text="[FormatDateTime([Rooms.Reservations.FromDate],'dd-MM-yyyy')]" Font="Arial,9pt"/>
      <TextObject Name="TextAlloc" Left="480" Width="60" Text="[Rooms.Reservations.Allocated]" HorzAlign="Right" Font="Arial,9pt"/>
    </DataBand>

    <!-- Per-Room Summary -->
    <GroupFooterBand Name="RoomFooter" Height="20">
      <TextObject Name="TxtRoomTotal" Left="300" Width="400" Height="18"
                  Text="Total devotees in this room: [Count(Rooms.Reservations.DevoteeCode)]"
                  Font="Arial,9pt,style=Bold" HorzAlign="Right"/>
    </GroupFooterBand>

    <!-- Report Summary -->
    <ReportSummaryBand Name="ReportSummary1" Height="25">
      <TextObject Name="TxtGrandTotal" Left="250" Width="400" Height="18"
                  Text="Grand Total Allocated: [Sum(Rooms.TotalAllocated)]"
                  Font="Arial,10pt,style=Bold" HorzAlign="Right"/>
    </ReportSummaryBand>

    <!-- Page Footer -->
    <PageFooterBand Name="PageFooter1" Height="20">
      <TextObject Name="TxtFooterLeft" Left="0" Width="400" Height="18"
                  Text="Printed on [FormatDateTime(Today, 'dd-MM-yyyy HH:mm')]"
                  Font="Arial,8pt"/>
      <TextObject Name="TxtFooterRight" Left="550" Width="200" Height="18"
                  HorzAlign="Right" Font="Arial,8pt"
                  Text="Page [Page#] of [TotalPages#]"/>
    </PageFooterBand>

  </ReportPage>
</Report>
