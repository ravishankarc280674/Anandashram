{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "font-awesome@7.0.0",
      "destination": "wwwroot/font-awesome/"
    },
    {
      "library": "webcamjs@1.0.26",
      "destination": "wwwroot/webcamjs/"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/"
    },
    {
      "library": "jquery-validate@1.21.0",
      "destination": "wwwroot/lib/jquery-validate/",
      "files": [
        "jquery.validate.min.js",
        "jquery.validate.js"
      ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/jquery-validation-unobtrusive/"
    },
    {
      "library": "Chart.js@4.5.0",
      "destination": "wwwroot/lib/Chart.js/"
    }
  ]
}