    <ProjectGuid>cb7d2059-9ebf-4428-369f-980b305c20db</ProjectGuid>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
</Project>